{
  "name": "@keating/desktop",
  "version": "4.0.7",
  "type": "module",
  "private": true,
  "description": "Keating desktop (Electron) app — P2P, local-first teaching client.",
  "author": "Diogenes of Toronto",
  "homepage": "https://keating.help",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diogenesoftoronto/keating.git"
  },
  "license": "MPL-2.0",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "bun run --cwd ../packages/p2p-core build && tsc -p tsconfig.json && bun scripts/build-needle-runtime.mjs && bun scripts/build-julia-runtime.mjs && KEATING_WEB_BUILD_TARGET=app bun run --cwd ../web build && node scripts/stage-nitro.mjs",
    "setup:electron": "node scripts/ensure-electron.mjs",
    "dev": "bun run setup:electron && bun run --cwd ../packages/p2p-core build && tsc -p tsconfig.json && bun scripts/build-needle-runtime.mjs && bun scripts/build-julia-runtime.mjs && KEATING_DEV_SERVER=${KEATING_DEV_SERVER:-http://localhost:3000} electron .",
    "start": "bun run setup:electron && electron .",
    "test": "bun test ./test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-builder",
    "stage:offline": "node scripts/stage-offline.mjs",
    "dist:offline": "node scripts/build-offline-edition.mjs",
    "dist:linux": "electron-builder --linux AppImage deb rpm",
    "dist:windows": "electron-builder --win nsis --x64",
    "dist:mac": "electron-builder --mac dmg zip --arm64"
  },
  "dependencies": {
    "@keating/p2p-core": "workspace:*",
    "onnxruntime-node": "1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "33.4.11",
    "electron-builder": "^25.0.0",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "help.keating.desktop",
    "compression": "maximum",
    "productName": "Keating",
    "beforePack": "scripts/offline-before-pack.cjs",
    "afterExtract": "scripts/native-after-extract.cjs",
    "win": {
      "forceCodeSigning": true,
      "signDlls": true,
      "signExts": [".node"],
      "signingHashAlgorithms": ["sha256"],
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "artifactName": "Keating-${version}-windows-${arch}-setup.${ext}",
      "icon": "../web/public/brand/logo-badge.png"
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["arm64"] }, { "target": "zip", "arch": ["arm64"] }],
      "artifactName": "Keating-${version}-macos-${arch}.${ext}",
      "category": "public.app-category.education",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "notarize": true,
      "entitlements": "signing/entitlements.mac.plist",
      "entitlementsInherit": "signing/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Keating uses your microphone when you choose voice learning.",
        "NSCameraUsageDescription": "Keating uses your camera when you choose a live learning session."
      },
      "binaries": ["Contents/Resources/offline/keating-offline", "Contents/Resources/offline/liblitert-lm.so"],
      "icon": "../web/public/brand/logo-badge.png"
    },
    "dmg": { "sign": true },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "shortcutName": "Keating"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"],
      "artifactName": "Keating-${version}-linux-${arch}.${ext}",
      "executableName": "keating-desktop",
      "maintainer": "Diogenes of Toronto",
      "category": "Education",
      "icon": "../web/public/brand/logo-badge.png"
    },
    "deb": { "packageName": "keating-desktop", "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libvulkan1"] },
    "rpm": { "packageName": "keating-desktop", "depends": ["gtk3", "libnotify", "nss", "libXScrnSaver", "libXtst", "xdg-utils", "at-spi2-core", "libuuid", "libsecret", "vulkan-loader"] },
    "files": ["**/*"],
    "extraResources": [
      { "from": "dist/offline", "to": "offline", "filter": ["**/*"] },
      {
        "from": "dist/nitro",
        "to": "nitro",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "node_modules/**/sodium-native/**/*",
      "node_modules/**/udx-native/**/*",
      "node_modules/**/rocksdb-native/**/*",
      "node_modules/**/fs-native-extensions/**/*",
      "node_modules/**/simdle-native/**/*",
      "node_modules/**/quickbit-native/**/*",
      "node_modules/onnxruntime-node/bin/**/*"
    ],
    "directories": { "app": "dist/app", "output": "release" }
  }
}
