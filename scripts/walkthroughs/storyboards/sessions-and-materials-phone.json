    {
      "kind": "click",
      "label": "CS",
      "within": "[aria-label=\"Filter sessions by subject\"]",
      "contains": true
    },
    {
      "kind": "pause",
      "ms": 3100,
      "still": "subject"
    },
    {
      "kind": "chapter",
      "id": "pin",
      "title": "Pin the lesson",
