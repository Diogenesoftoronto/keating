    },
    {
      "kind": "caption",
      "text": "Open your session library."
    },
    {
      "kind": "click",
      "label": "Open sessions panel"
    },
    {
      "kind": "wait-for",
      "text": "How recursion returns",
      "timeout": 7000
    },
    {
      "kind": "pause",
      "ms": 3100,
      "still": "library"
    },
    {
      "kind": "chapter",
      "id": "search",
      "title": "Find a session",
      "explanation": "Search your sessions for recursion.",
      "alt": "Find a session"
    },
    {
      "kind": "caption",
      "text": "Search your sessions for recursion."
    },
    {
