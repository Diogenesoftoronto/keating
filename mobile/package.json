{
  "name": "keating-mobile",
  "version": "4.0.14",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web --port 8081",
    "android": "expo run:android --device",
    "android:prebuild": "expo prebuild --platform android",
    "android:prebuild:clean": "expo prebuild --clean --platform android",
    "android:apk": "expo prebuild --platform android --no-install && node scripts/pin-gradle-wrapper.mjs && cd android && ./gradlew assembleDebug",
    "android:apk:release": "expo prebuild --platform android --no-install && node scripts/pin-gradle-wrapper.mjs && node scripts/prepare-android-release.mjs && cd android && ./gradlew :app:assembleRelease --no-daemon",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/*.test.ts",
    "export:android": "EXPO_NO_BUNDLE_SPLITTING=1 expo export --platform android --output-dir dist/android",
    "doctor": "expo-doctor",
    "gt:translate": "gt translate --config gt.config.json",
    "gt:check": "gt translate --config gt.config.json --dry-run"
  },
  "dependencies": {
    "@daily-co/config-plugin-rn-daily-js": "0.0.12",
    "@daily-co/react-native-daily-js": "0.87.1",
    "@daily-co/react-native-webrtc": "124.0.6-daily.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@formatjs/intl-displaynames": "7.3.15",
    "@formatjs/intl-getcanonicallocales": "3.2.12",
    "@formatjs/intl-locale": "5.3.12",
    "@huggingface/tokenizers": "0.2.0",
    "@keating/design-contract": "workspace:*",
    "@keating/learner-contracts": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.26",
    "expo-audio": "~57.0.5",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fflate": "^0.8.3",
    "gt-react-native": "^11.4.7",
    "katex": "^0.19.0",
    "marked": "18.0.14",
    "mermaid": "^12.0.0",
    "onnxruntime-react-native": "1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-background-timer": "^2.4.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@types/react": "~19.2.18",
    "expo-doctor": "^1.20.4",
    "gt": "^2.23.1",
    "typescript": "~6.0.3"
  }
}
