{
  "expo": {
    "name": "Keating",
    "slug": "keating",
    "version": "3.13.1",
    "orientation": "portrait",
    "scheme": "keating",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0c1510",
    "primaryColor": "#1e9b50",
    "icon": "./assets/brand/app-icon-lockup.png",
    "android": {
      "package": "com.diogenesoftoronto.keating",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-icon-lockup.png",
        "backgroundColor": "#0c1510"
      }
    },
    "ios": {
      "bundleIdentifier": "com.diogenesoftoronto.keating",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Keating to share your camera with KeatingBot during Live lessons.",
        "NSMicrophoneUsageDescription": "Allow Keating to hear you during Live lessons.",
        "UIBackgroundModes": [
          "voip"
        ]
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Keating to record speech for message dictation and Live conversations."
        }
      ],
      [
        "@daily-co/config-plugin-rn-daily-js",
        {
          "enableCamera": true,
          "enableMicrophone": true,
          "enableScreenShare": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f1ece0",
          "image": "./assets/brand/logo-lockup-hd.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0c1510"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
