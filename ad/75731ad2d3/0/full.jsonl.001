\",\nsrc/mcp/server.ts:464:        const result = await timelineArtifact(cwd);\nsrc/core/lesson-plan.ts:97:        purpose: \"Write and trace runnable code so the learner sees the concept execute.\",\nsrc/core/lesson-plan.ts:131:        `Place ${topic.title} on a timeline with at least two contextual events.`,\nsrc/pi/hyper-teacher/index.ts:8:  dueTopicsArtifact,\nsrc/pi/hyper-teacher/index.ts:17:  timelineArtifact,\nsrc/pi/hyper-teacher/index.ts:21:import { loadLearnerState, recordFeedback, recordSessionStart, saveLearnerState } from \"../../core/learner-state.js\";\nsrc/pi/hyper-teacher/index.ts:106:        `Benchmark score ${artifact.overallScore.toFixed(2)} saved to ${relative(ctx.cwd, artifact.reportPath)}${artifact.tracePath ? ` with trace ${relative(ctx.cwd, artifact.tracePath)}` : \"\"}`\nsrc/pi/hyper-teacher/index.ts:119:        `Policy evolved to ${artifact.bestScore.toFixed(2)} and saved to ${relative(ctx.cwd, artifact.policyPath)}${artifact.tracePath ? ` with trace ${relative(ctx.cwd, artifact.tracePath)}` : \"\"}`\nsrc/pi/hyper-teacher/index.ts:196:      const artifacts = await listArtifacts(ctx.cwd);\nsrc/pi/hyper-teacher/index.ts:251:      const state = await loadLearnerState(statePath);\nsrc/pi/hyper-teacher/index.ts:253:      await saveLearnerState(statePath, state);\nsrc/pi/hyper-teacher/index.ts:291:  pi.registerCommand(\"trace\", {\nsrc/pi/hyper-teacher/index.ts:292:    description: \"Browse persisted benchmark and evolution traces.\",\nsrc/pi/hyper-teacher/index.ts:295:      const artifacts = (await listArtifacts(ctx.cwd)).filter((artifact) =>\nsrc/pi/hyper-teacher/index.ts:299:        info(ctx, \"No matching trace artifacts. Use /bench or /evolve first.\");\nsrc/pi/hyper-teacher/index.ts:314:      const state = await loadLearnerState(statePath);\nsrc/pi/hyper-teacher/index.ts:334:  pi.registerCommand(\"timeline\", {\nsrc/pi/hyper-teacher/index.ts:335:    description: \"Show the engagement timeline for all covered topics, sorted by review urgency.\",\nsrc/pi/hyper-teacher/index.ts:337:      const artifact = await timelineArtifact(ctx.cwd);\nsrc/pi/hyper-teacher/index.ts:339:      info(ctx, `Engagement timeline saved to ${relative(ctx.cwd, artifact.reportPath)}`);\nsrc/pi/hyper-teacher/index.ts:346:      const artifact = await dueTopicsArtifact(ctx.cwd);\nsrc/pi/hyper-teacher/index.ts:360:    const state = await loadLearnerState(statePath);\nsrc/pi/hyper-teacher/index.ts:362:    await saveLearnerState(statePath, state);\nsrc/pi/hyper-teacher/index.ts:385:    const dueArtifact = await dueTopicsArtifact(ctx.cwd);\ntest/final_dataset.json:71:        \"content\": \"# Lesson: The Derivative (Continued)\\n\\n## \\ud83d\\udcdd Clarifying the Question\\n\\nI noticed you shared the header\\u2014let me make sure we're on the same page!\\n\\nI asked: **If *f'(2) = 5*, what does this tell you?**\\n\\nThis is a quick conceptual check before we move to practice. Let me offer a scaffold if it's feeling abstract:\\n\\n> **Hint:** Remember\\u2014*f'(x)* is the instantaneous rate of change of *f* at the point *x*. So *f'(2)* specifically tells you about the rate of change *at x = 2*.\\n\\n**Try one of these:**\\n- **(a)** At *x = 2*, the function is increasing at a rate of 5 units per unit of *x*\\n- **(b)** At *x = 2*, the slope of the tangent line is 5\\n- **(c)** Both of the above (they're the same statement, just different language)\\n- **(d)** Something else\\u2014here's my reasoning: **__**\\n\\nNo right-or-wrong pressure here. Even a partial intuition helps me know whether to emphasize the \\\"rate of change\\\" framing or the \\\"slope of tangent\\\" framing going forward.\\n\\n---\\n\\n## \\ud83d\\udcca Concept Map\\n\\nWhile you think, here's a map of where we've been and where we're headed:\\n\\n```\\nPrerequisites (Functions, Limits, Slope)\\n         \\u2193\\n   Intuition (Average \\u2192 Instantaneous)\\n         \\u2193\\n   Formal Core (Difference Quotient, Differentiability)\\n         \\u2193\\n   Misconception Repair (It's not just a formula!)\\n         \\u2193\\n   Worked Examples (x\\u00b2, position/velocity)\\n         \\u2193\\nGuided Practice \\u2190 You are here\\n         \\u2193\\n   Transfer (Motion, Optimization, Science)\\n```\\n\\nCan you trace through the map and narrate it back to me in your own words? That helps me check whether the structure is landing.\\n\\n---\\n\\nOnce you've answered the *f'(2) = 5* question (or told me where you're stuck), we can move to **guided practice**\\u2014estimating derivatives from tables and graphs.\"\ntest/final_dataset.json:399:        \"content\": \"Excellent. That understanding is solid now.\\n\\…1825 tokens truncated…(statePath, state);\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:77:    \"trace\",\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:78:    \"trace\",\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:80:    { type: { type: \"string\", enum: [\"benchmark\", \"evolution\", \"all\"], description: \"Filter by trace type\" } },\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:83:      const artifacts = (await listArtifacts(getCwd())).filter((a: any) =>\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:86:      if (artifacts.length === 0) return { content: [{ type: \"text\", text: \"No traces yet. Run auto_improve or bench first.\" }] };\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:87:      const list = artifacts.map((a: any) => `- ${a.label} (${new Date(a.createdAt).toLocaleDateString()})`).join(\"\\n\");\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:107:      const artifacts = await listArtifacts(getCwd());\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:109:      const list = artifacts.slice(0, 20).map((a: any) => `- ${a.label} (${new Date(a.createdAt).toLocaleDateString()})`).join(\"\\n\");\nsrc/pi/hyper-teacher/tools/self-evaluation.ts:110:      return { content: [{ type: \"text\", text: `Keating Artifacts (${artifacts.length} total)\\n\\n${list}` }] };\nsrc/core/types.ts:112:  trace: BenchmarkTrace;\ntest/traces/Qwen-2.5-1.5B_derivative_1775201306.json:29:      \"content\": \"Excellent. That understanding is solid now.\\n\\n---\\n\\n## From Intuition to Formal Definition\\n\\nLet's write down what we've been doing in precise language.\\n\\n**The derivative** of a function f at a point x is defined as:\\n\\n$$f'(x) = \\\\lim_{h \\\\to 0} \\\\frac{f(x+h) - f(x)}{h}$$\\n\\nThis is called the **difference quotient**. Here's what each piece means:\\n\\n- **f(x+h) \\u2212 f(x)** is the change in the function's output over the interval\\n- **h** is the change in the input (how far we moved along the x-axis)\\n- **The quotient** is the average rate of change over that interval\\n- **The limit as h \\u2192 0** collapses the interval until it's effectively an instant\\n\\nFor f(x) = x\\u00b2 at x = 3, we computed:\\n\\n$$f'(3) = \\\\lim_{h \\\\to 0} \\\\frac{(3+h)^2 - 9}{h} = \\\\lim_{h \\\\to 0} (6 + h) = 6$$\\n\\n---\\n\\n## A Critical Distinction: Differentiability vs. Continuity\\n\\nHere is a subtle but important point that surprises many learners.\\n\\n**If a function is differentiable at a point, it must be continuous there.**\\n\\nThe derivative requires a well-defined tangent, and you can't have a tangent through a gap or a jump. Differentiability implies continuity.\\n\\n**But the reverse is false.** A function can be continuous at a point and *still not have a derivative there.\\n\\nHere's the classic example: f(x) = |x| at x = 0.\\n\\n- It is continuous\\u2014there's no break in the graph.\\n- But it is **not differentiable** at x = 0. Why? The function comes in with slope \\u22121 from the left and slope +1 from the right. There is no single tangent line\\u2014two different slopes fight for the same point.\\n\\nThe graph has a sharp \\\"corner\\\" at the origin. Your finger can trace it without lifting, but you can't assign one slope to that point.\\n\\n> **Differentiability is a stronger condition than continuity.** Differentiability requires smoothness; continuity only requires no jumps.\\n\\n---\\n\\n## Quick Check\\n\\nConsider f(x) = |x| at x = 0.\\n\\n- Is it continuous at x = 0? Yes or no, and why?\\n- Is it differentiable at x = 0? Yes or no, and why?\\n\\nAnswer both, then I'll show you one more example before we practice.\"\nsrc/pi/hyper-teacher/tools/feedback.ts:2:import { loadLearnerState, recordFeedback, saveLearnerState } from \"../../../core/learner-state.js\";\nsrc/pi/hyper-teacher/tools/feedback.ts:20:      const state = await loadLearnerState(statePath);\nsrc/pi/hyper-teacher/tools/feedback.ts:22:      await saveLearnerState(statePath, state);\nsrc/pi/hyper-teacher/tools/teaching.ts:10:import { loadLearnerState, recordQuizResult, saveLearnerState } from \"../../../core/learner-state.js\";\nsrc/pi/hyper-teacher/tools/teaching.ts:17:  const state = await loadLearnerState(statePath);\nsrc/pi/hyper-teacher/tools/teaching.ts:19:  await saveLearnerState(statePath, state);\nsrc/pi/hyper-teacher/tools/teaching.ts:82:        content: [{ type: \"text\", text: `[artifact://verification]\\n${artifact.alreadyVerified ? \"Already verified\" : \"Generated checklist\"}: ${relative(getCwd(), artifact.checklistPath)}` }],\nsrc/pi/hyper-teacher/tools/teaching.ts:86:    { result: artifactPreviewRenderer(\"Verification Checklist\", \"checklistPath\") }\nsrc/pi/hyper-teacher/tools/shared.ts:3:import type { loadLearnerState } from \"../../../core/learner-state.js\";\nsrc/pi/hyper-teacher/tools/shared.ts:22:export function feedbackOnlyTopics(state: Awaited<ReturnType<typeof loadLearnerState>>): string[] {\nsrc/core/self-improve.ts:7:import { currentPolicyPath, stateDir, outputsDir, learnerStatePath } from \"./paths.js\";\nsrc/core/self-improve.ts:9:import { loadLearnerState } from \"./learner-state.js\";\nsrc/core/self-improve.ts:93:  return join(outputsDir(cwd), \"improvements\");\nsrc/core/self-improve.ts:114:// Diagnosis: analyze benchmark traces to find weaknesses\nsrc/core/self-improve.ts:224:  const learnerState = await loadLearnerState(learnerStatePath(cwd));\nsrc/core/self-improve.ts:274:    \"Where applicable, leverage these Ax optimization traces to inform your changes:\",\nsrc/core/self-improve.ts:275:    `- **GEPA Pareto Front**: Check \\`.keating/state/gepa-optimized.json\\` for multi-objective hyperparameter tuning traces.`,\nsrc/core/self-improve.ts:368:  const learnerState = await loadLearnerState(learnerStatePath(cwd));\nsrc/core/animation.ts:16:  | \"code-trace\"\nsrc/core/animation.ts:17:  | \"timeline\"\nsrc/core/animation.ts:48:    case \"code\": return \"code-trace\";\nsrc/core/animation.ts:49:    case \"history\": return \"timeline\";\nsrc/core/animation.ts:70:          : sceneKind === \"code-trace\"\nsrc/core/animation.ts:71:            ? \"A code-trace scene shows execution flow, variable state, and call-stack evolution step by step.\"\nsrc/core/animation.ts:72:            : sceneKind === \"timeline\"\nsrc/core/animation.ts:73:              ? \"A timeline scene places events in chronological order so causal relationships and periodization become visible.\"\nsrc/core/animation.ts:183:    const tl = gsap.timeline({ defaults: { ease: \"power3.out\" } });\nsrc/core/animation.ts:218:We are using Hyperframes: one self-contained HTML document with semantic sections, CSS, and a GSAP timeline loaded from https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js.\nsrc/core/animation.ts:221:Respond ONLY with the complete HTML document. Do NOT wrap it in markdown fences. Do not provide a preamble or explanation. The animation must use GSAP timelines for real motion, be 16:9 friendly, and visibly teach the exact topic instead of showing a generic title card.`;\nsrc/core/animation.ts:357:      function timeline() {\nrtk: Broken pipe (os error 32)\nimport { mkdir } from \"node:fs/promises\";\nimport { join } from \"node:path\";\n\nexport function keatingRoot(cwd: string): string {\n  return join(cwd, \".keating\");\n}\n\nexport function stateDir(cwd: string): string {\n  return join(keatingRoot(cwd), \"state\");\n}\n\nexport function outputsDir(cwd: string): string {\n  return join(keatingRoot(cwd), \"outputs\");\n}\n\nexport function plansDir(cwd: string): string {\n  return join(outputsDir(cwd), \"plans\");\n}\n\nexport function mapsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"maps\");\n}\n\nexport function animationsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"animations\");\n}\n\nexport function benchmarksDir(cwd: string): string {\n  return join(outputsDir(cwd), \"benchmarks\");\n}\n\nexport function evolutionDir(cwd: string): string {\n  return join(outputsDir(cwd), \"evolution\");\n}\n\nexport function promptEvolutionDir(cwd: string): string {\n  return join(outputsDir(cwd), \"prompt-evolution\");\n}\n\nexport function improvementsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"improvements\");\n}\n\nexport function tracesDir(cwd: string): string {\n  return join(outputsDir(cwd), \"traces\");\n}\n\nexport function sessionsDir(cwd: string): string {\n  return join(keatingRoot(cwd), \"sessions\");\n}\n\nexport function configDir(cwd: string): string {\n  return join(keatingRoot(cwd), \"pi-config\");\n}\n\nexport function currentPolicyPath(cwd: string): string {\n  return join(stateDir(cwd), \"current-policy.json\");\n}\n\nexport function policyArchivePath(cwd: string): string {\n  return join(stateDir(cwd), \"policy-archive.json\");\n}\n\nexport function promptEvolutionArchivePath(cwd: string): string {\n  return join(stateDir(cwd), \"prompt-evolution-archive.json\");\n}\n\nexport function learnerStatePath(cwd: string): string {\n  return join(stateDir(cwd), \"learner.json\");\n}\n\nexport function goalsStatePath(cwd: string): string {\n  return join(stateDir(cwd), \"goals.json\");\n}\n\nexport function verificationsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"verifications\");\n}\n\nexport function verificationCachePath(cwd: string): string {\n  return join(stateDir(cwd), \"verification-cache.json\");\n}\n\nexport function engagementPolicyPath(cwd: string): string {\n  return join(stateDir(cwd), \"engagement-policy.json\");\n}\n\nexport function timelineDir(cwd: string): string {\n  return join(outputsDir(cwd), \"timelines\");\n}\n\nexport function quizDir(cwd: string): string {\n  return join(outputsDir(cwd), \"quizzes\");\n}\n\nexport function flashcardsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"flashcards\");\n}\n\nexport function projectsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"projects\");\n}\n\nexport function masteryDir(cwd: string): string {\n  return join(outputsDir(cwd), \"mastery\");\n}\n\nexport function workbooksDir(cwd: string): string {\n  return join(outputsDir(cwd), \"workbooks\");\n}\n\nexport function exportsDir(cwd: string): string {\n  return join(outputsDir(cwd), \"exports\");\n}\n\nexport async function ensureKeatingDirs(cwd: string): Promise<void> {\n  await Promise.all([\n    mkdir(stateDir(cwd), { recursive: true }),\n    mkdir(join(stateDir(cwd), \"snapshots\"), { recursive: true }),\n    mkdir(plansDir(cwd), { recursive: true }),\n    mkdir(mapsDir(cwd), { recursive: true }),\n    mkdir(animationsDir(cwd), { recursive: true }),\n    mkdir(benchmarksDir(cwd), { recursive: true }),\n    mkdir(evolutionDir(cwd), { recursive: true }),\n    mkdir(promptEvolutionDir(cwd), { recursive: true }),\n    mkdir(tracesDir(cwd), { recursive: true }),\n    mkdir(verificationsDir(cwd), { recursive: true }),\n    mkdir(improvementsDir(cwd), { recursive: true }),\n    mkdir(sessionsDir(cwd), { recursive: true }),\n    mkdir(timelineDir(cwd), { recursive: true }),\n    mkdir(quizDir(cwd), { recursive: true }),\n    mkdir(flashcardsDir(cwd), { recursive: true }),\n    mkdir(projectsDir(cwd), { recursive: true }),\n    mkdir(masteryDir(cwd), { recursive: true }),\n    mkdir(workbooksDir(cwd), { recursive: true }),\n    mkdir(exportsDir(cwd), { recursive: true }),\n    mkdir(configDir(cwd), { recursive: true })\n  ]);\n}\nimport { readFile, writeFile } from \"node:fs/promises\";\n\nimport {\n  EngagementPolicy,\n  EngagementTimeline,\n  LearnerState,\n  TopicEngagement\n} from \"./types.js\";\nimport { mean } from \"./util.js\";\nimport { titleCase, slugify } from \"./util.js\";\n\nexport const DEFAULT_ENGAGEMENT_POLICY: EngagementPolicy = {\n  name: \"spaced-revisit-default\",\n  retentionHalfLifeDays: 7,\n  dueThreshold: 0.5,\n  minReviewIntervalDays: 1,\n  urgencyTiers: [21, 14, 7, 3]\n};\n\nconst MS_PER_DAY = 86_400_000;\n\nfunction daysBetween(a: string | Date | undefined, b: string | Date): number {\n  if (!a) return 0;\n  const msA = typeof a === \"string\" ? new Date(a).getTime() : a.getTime();\n  const msB = typeof b === \"string\" ? new Date(b).getTime() : b.getTime();\n  if (!Number.isFinite(msA) || !Number.isFinite(msB)) return 0;\n  return Math.abs(msB - msA) / MS_PER_DAY;\n}\n\n/**\n * Estimate retention using an exponential decay model inspired by Ebbinghaus.\n * retention = mastery × e^(-t / (halfLife × masteryFactor))\n *\n * Higher mastery extends the half-life: a topic mastered at 0.9 decays\n * more slowly than one mastered at 0.3.\n */\nfunction estimateRetention(\n  masteryEstimate: number,\n  daysSinceLastSeen: number,\n  halfLifeDays: number\n): number {\n  const masteryFactor = 0.5 + masteryEstimate * 1.5; // range: 0.5–2.0\n  const effectiveHalfLife = halfLifeDays * masteryFactor;\n  const decay = Math.exp((-daysSinceLastSeen * Math.LN2) / effectiveHalfLife);\n  return Math.max(0, Math.min(1, masteryEstimate * decay));\n}\n\n/**\n * Compute urgency: 0 = not urgent, 1 = critically overdue.\n * Based on how far retention has fallen below the due threshold.\n */\nfunction computeUrgency(\n  estimatedRetention: number,\n  dueThreshold: number,\n  daysSinceLastSeen: number,\n  tiers: [number, number, number, number]\n): { urgency: number; label: TopicEngagement[\"urgencyLabel\"] } {\n  if (daysSinceLastSeen < 1) {\n    return { urgency: 0, label: \"fresh\" };\n  }\n\n  if (estimatedRetention >= dueThreshold) {\n    return { urgency: Math.max(0, 1 - estimatedRetention / dueThreshold) * 0.3, label: \"low\" };\n  }\n\n  // Retention is below threshold — compute urgency based on how far below\n  const deficit = dueThreshold - estimatedRetention;\n  const rawUrgency = Math.min(1, deficit / dueThreshold + 0.3);\n\n  let label: TopicEngagement[\"urgencyLabel\"];\n  if (daysSinceLastSeen >= tiers[0]) {\n    label = \"critical\";\n  } else if (daysSinceLastSeen >= tiers[1]) {\n    label = \"high\";\n  } else if (daysSinceLastSeen >= tiers[2]) {\n    label = \"moderate\";\n  } else {\n    label = \"low\";\n  }\n\n  return { urgency: rawUrgency, label };\n}\n\n/**\n * Estimate when the next review should happen based on current mastery\n * and the retention decay model.\n */\nfunction estimateNextReview(\n  lastSeen: string | undefined,\n  masteryEstimate: number,\n  halfLifeDays: number,\n  dueThreshold: number\n): string {\n  if (!lastSeen) return new Date().toISOString();\n  if (masteryEstimate <= dueThreshold) {\n    return new Date().toISOString();\n  }\n  const masteryFactor = 0.5 + masteryEstimate * 1.5;\n  const effectiveHalfLife = halfLifeDays * masteryFactor;\n  const daysUntilDue = (-effectiveHalfLife * Math.log(dueThreshold / masteryEstimate)) / Math.LN2;\n  const lastSeenMs = new Date(lastSeen).getTime();\n  if (!Number.isFinite(lastSeenMs)) return new Date().toISOString();\n  return new Date(lastSeenMs + daysUntilDue * MS_PER_DAY).toISOString();\n}\n\nexport function computeTopicEngagement(\n  topic: LearnerState[\"coveredTopics\"][number],\n  policy: EngagementPolicy,\n  now: Date = new Date()\n): TopicEngagement {\n  const daysSince = daysBetween(topic.lastSeen, now);\n  const retention = estimateRetention(\n    topic.masteryEstimate,\n    daysSince,\n    policy.retentionHalfLifeDays\n  );\n  const isDue = retention < policy.dueThreshold && daysSince >= policy.minReviewIntervalDays;\n  const { urgency, label } = computeUrgency(\n    retention,\n    policy.dueThreshold,\n    daysSince,\n    policy.urgencyTiers\n  );\n  const nextReview = estimateNextReview(\n    topic.lastSeen,\n    topic.masteryEstimate,\n    policy.retentionHalfLifeDays,\n    policy.dueThreshold\n  );\n\n  // Defensive: older learner.json files (or partial writes) can have a topic\n  // entry missing `slug`. Derive one from any available label so the timeline\n  // never crashes the extension at session_start.\n  const rawSlug =\n    topic.slug ||\n    ((topic as any).title ? slugify((topic as any).title) : null) ||\n    \"unknown-topic\";\n\n  return {\n    slug: rawSlug,\n    title: titleCase(rawSlug.replace(/-/g, \" \")),\n    domain: topic.domain,\n    lastSeen: topic.lastSeen,\n    daysSinceLastSeen: daysSince,\n    masteryEstimate: topic.masteryEstimate,\n    estimatedRetention: retention,\n    isDue,\n    urgency,\n    urgencyLabel: label,\n    sessionCount: topic.sessionCount,\n    nextReviewAt: nextReview\n  };\n}\n\nexport function buildEngagementTimeline(\n  state: LearnerState,\n  policy: EngagementPolicy = DEFAULT_ENGAGEMENT_POLICY,\n  now: Date = new Date()\n): EngagementTimeline {\n  const topics = (state.coveredTopics ?? [])\n    .filter((t): t is NonNullable<typeof t> => Boolean(t))\n    .map(t => computeTopicEngagement(t, policy, now));\n\n  // Sort by urgency descending (most urgent first)\n  topics.sort((a, b) => b.urgency - a.urgency);\n\n  const dueCount = topics.filter(t => t.isDue).length;\n  const criticalCount = topics.filter(t => t.urgencyLabel === \"critical\").length;\n  const averageRetention = topics.length > 0 ? mean(topics.map(t => t.estimatedRetention)) : 1;\n  const oldestUnreviewedDays = topics.length > 0\n    ? Math.max(...topics.map(t => t.daysSinceLastSeen))\n    : 0;\n\n  return {\n    generatedAt: now.toISOString(),\n    policy,\n    topics,\n    summary: {\n      totalTopics: topics.length,\n      dueCount,\n      criticalCount,\n      averageRetention,\n      oldestUnreviewedDays\n    }\n  };\n}\n\nexport function dueTopics(\n  state: LearnerState,\n  policy: EngagementPolicy = DEFAULT_ENGAGEMENT_POLICY,\n  now: Date = new Date()\n): TopicEngagement[] {\n  const timeline = buildEngagementTimeline(state, policy, now);\n  return timeline.topics.filter(t => t.isDue);\n}\n\nfunction retentionBar(retention: number): string {\n  const filled = Math.round(retention * 10);\n  return \"█\".repeat(filled) + \"░\".repeat(10 - filled);\n}\n\nfunction urgencyEmoji(label: TopicEngagement[\"urgencyLabel\"]): string {\n  switch (label) {\n    case \"critical\": return \"🔴\";\n    case \"high\": return \"🟠\";\n    case \"moderate\": return \"🟡\";\n    case \"low\": return \"🟢\";\n    case \"fresh\": return \"✨\";\n  }\n}\n\nfunction formatDays(days: number): string {\n  if (days < 1) return \"today\";\n  if (days < 2) return \"1 day ago\";\n  if (days < 7) return `${Math.floor(days)} days ago`;\n  if (days < 14) return \"1 week ago\";\n  if (days < 30) return `${Math.floor(days / 7)} weeks ago`;\n  if (days < 60) return \"1 month ago\";\n  return `${Math.floor(days / 30)} months ago`;\n}\n\nexport function engagementTimelineToMarkdown(timeline: EngagementTimeline): string {\n  const lines = [\n    \"# Engagement Timeline\",\n    \"\",\n    `Generated: ${new Date(timeline.generatedAt).toLocaleString()}`,\n    \"\",\n    \"## Summary\",\n    \"\",\n    `- **Topics tracked:** ${timeline.summary.totalTopics}`,\n    `- **Due for review:** ${timeline.summary.dueCount}`,\n    `- **Critical:** ${timeline.summary.criticalCount}`,\n    `- **Average retention:** ${(timeline.summary.averageRetention * 100).toFixed(1)}%`,\n    `- **Oldest unreviewed:** ${formatDays(timeline.summary.oldestUnreviewedDays)}`,\n    \"\"\n  ];\n\n  if (timeline.topics.length === 0) {\n    lines.push(\"No topics covered yet. Start a lesson to begin tracking.\");\n    return `${lines.join(\"\\n\")}\\n`;\n  }\n\n  lines.push(\"## Topics\");\n  lines.push(\"\");\n  lines.push(\"| Status | Topic | Last Seen | Retention | Mastery | Sessions | Next Review |\");\n  lines.push(\"| :---: | --- | --- | --- | ---: | ---: | --- |\");\n\n  for (const topic of timeline.topics) {\n    lines.push(\n      `| ${urgencyEmoji(topic.urgencyLabel)} | **${topic.title}** (${topic.domain}) | ${formatDays(topic.daysSinceLastSeen)} | ${retentionBar(topic.estimatedRetention)} ${(topic.estimatedRetention * 100).toFixed(0)}% | ${(topic.masteryEstimate * 100).toFixed(0)}% | ${topic.sessionCount} | ${topic.isDue ? \"**NOW**\" : new Date(topic.nextReviewAt).toLocaleDateString()} |`\n    );\n  }\n\n  lines.push(\"\");\n\n  // Legend\n  lines.push(\"### Legend\");\n  lines.push(\"\");\n  lines.push(\"- 🔴 Critical — severely overdue, retention critically low\");\n  lines.push(\"- 🟠 High — significantly overdue, review soon\");\n  lines.push(\"- 🟡 Moderate — approaching review threshold\");\n  lines.push(\"- 🟢 Low — retention adequate, no rush\");\n  lines.push(\"- ✨ Fresh — recently covered\");\n  lines.push(\"\");\n\n  return `${lines.join(\"\\n\")}\\n`;\n}\n\nexport function dueTopicsToMarkdown(topics: TopicEngagement[]): string {\n  if (topics.length === 0) {\n    return \"# Due Topics\\n\\n✅ All topics are up to date! No reviews needed right now.\\n\";\n  }\n\n  const lines = [\n    \"# Due Topics\",\n    \"\",\n    `${topics.length} topic${topics.length === 1 ? \"\" : \"s\"} due for review:`,\n    \"\"\n  ];\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"a253b762-0ccd-4d5b-9bfc-adadeef56bed"}}}
