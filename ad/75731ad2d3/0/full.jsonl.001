: Promise<unknown>;\nsrc/tui/prompt-recovery.ts:3:  followUp(message: string): Promise<unknown>;\nsrc/tui/prompt-recovery.ts:8:  | { ok: false; message: string; error: unknown }\nsrc/tui/ui/types.ts:42:  | { ok: false; recovery: UiRecovery };\nsrc/tui/ui/types.ts:45:  | { ok: true; result: UiActionResult; replayed: boolean; recovery?: UiRecovery }\nsrc/tui/ui/types.ts:46:  | { ok: false; recovery: UiRecovery };\nsrc/tui/review.ts:49:function validReviewState(value: unknown): value is TuiReviewState {\nsrc/tui/review.ts:72:  let candidate: unknown;\nsrc/tui/review.ts:143:    provenance: \"Card schedules are observed terminal review records. Topic urgency is an estimate derived from local learner history, not provider usage or proven mastery.\",\nsrc/tui/view-model.ts:52:function asRecord(value: unknown): Record<string, unknown> {\nsrc/tui/view-model.ts:54:    ? value as Record<string, unknown>\nsrc/tui/view-model.ts:58:export function messageText(message: unknown): string {\nsrc/tui/view-model.ts:71:function stableId(prefix: string, message: Record<string, unknown>, index: number): string {\nsrc/tui/view-model.ts:77:export function sanitizeDiagnostic(value: unknown, maxLength = 700): string {\nsrc/tui/view-model.ts:97:export function transcriptEntriesFromMessages(messages: readonly unknown[]): TranscriptEntry[] {\nsrc/tui/ui/rpc-action-transport.ts:29:  onEvent(listener: (event: unknown) => void): (() => void) | void;\nsrc/tui/ui/rpc-action-transport.ts:35:function boundedBase64UrlJson(value: unknown): string {\nsrc/tui/ui/rpc-action-transport.ts:43:function parseBoundedBase64UrlJson(encoded: string): unknown {\nsrc/tui/ui/rpc-action-transport.ts:141:  private handleEvent(event: unknown): void {\nsrc/tui/ui/rpc-action-transport.ts:232:        : retryableResult(envelope.action, envelope.sourceDocument, outcome.recovery.message);\nsrc/tui/ui/adapter.ts:17:function asRecord(value: unknown): Record<string, unknown> | undefined {\nsrc/tui/ui/adapter.ts:18:  return value &