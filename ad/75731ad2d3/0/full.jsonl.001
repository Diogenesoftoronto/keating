eys: ProviderKeysStore;\n    20: providerKeys: ProviderKeysStore,\n    26: this.providerKeys = providerKeys;\n\n[file] web/.../stores/provider-keys-store.ts (1):\n     7: export class ProviderKeysStore extends Store {\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b"}}}
