{"timestamp":"2026-08-11T10:32:12.358Z","type":"event_msg","payload":{"type":"agent_message","message":"The real no-credential PTY exposed another hidden mismatch: the RPC accepts a prompt before the provider later fails, so the existing “send accepted” logic cleared the draft too early. I’m moving recovery to the actual `message_end`/`agent_end` lifecycle so provider errors and aborts restore the exact text only after the generation truly terminates.","phase":"commentary","memory_citation":null}}
{"timestamp":"2026-08-11T10:32:12.358Z","type":"response_item","payload":{"type":"message","id":"msg_02b258e8e56f2fcd016a7afa2aec148190afe452cf33be8188","role":"assistant","content":[{"type":"output_text","text":"The real no-credential PTY exposed another hidden mismatch: the RPC accepts a prompt before the provider later fails, so the existing “send accepted” logic cleared the draft too early. I’m moving recovery to the actual `message_end`/`agent_end` lifecycle so provider errors and aborts restore the exact text only after the generation truly terminates."}],"phase":"commentary","internal_chat_message_metadata_passthrough":{"turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467"}}}
{"timestamp":"2026-08-11T10:32:26.599Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_02b258e8e56f2fcd016a7afa2c4b008190bf2f3b2297bc43fc","status":"completed","call_id":"call_d0vOaqjLWIHmzWj0KiPqKWTc","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Update File: /home/diogenes/Projects/keating/src/tui/prompt-recovery.ts\\n@@\\n export class TuiPromptRecovery {\\n   private failedDraft: string | null = null;\\n   private failedMessage: string | null = null;\\n+  private activeDraft: string | null = null;\\n+  private activeMessage: string | null = null;\\n@@\\n   get draft(): string | null {\\n     return this.failedDraft;\\n   }\\n+\\n+  get pendingDraft(): string | null {\\n+    return this.activeDraft;\\n+  }\\n@@\\n   async send(draft: string, busy: boolean, message = draft): Promise<TuiPromptSendOutcome> {\\n+    this.activeDraft = draft;\\n+    this.activeMessage = message;\\n+    this.failedDraft = null;\\n+    this.failedMessage = null;\\n     try {\\n       if (busy) await this.client.followUp(message);\\n       else await this.client.prompt(message);\\n-      this.failedDraft = null;\\n-      this.failedMessage = null;\\n       return { ok: true, message: draft };\\n     } catch (error) {\\n+      this.activeDraft = null;\\n+      this.activeMessage = null;\\n       this.failedDraft = draft;\\n       this.failedMessage = message;\\n       return { ok: false, message: draft, error };\\n     }\\n   }\\n+\\n+  /** Commit an accepted send only after Pi reports a successful agent end. */\\n+  completePending(): string | null {\\n+    const draft = this.activeDraft;\\n+    this.activeDraft = null;\\n+    this.activeMessage = null;\\n+    this.failedDraft = null;\\n+    this.failedMessage = null;\\n+    return draft;\\n+  }\\n+\\n+  /** Restore the exact accepted draft after an asynchronous provider failure or abort. */\\n+  failPending(): string | null {\\n+    const draft = this.activeDraft;\\n+    if (draft === null) return null;\\n+    this.failedDraft = draft;\\n+    this.failedMessage = this.activeMessage ?? draft;\\n+    this.activeDraft = null;\\n+    this.activeMessage = null;\\n+    return draft;\\n+  }\\n*** Update File: /home/diogenes/Projects/keating/src/tui/opentui-host.ts\\n@@\\n   const uiActionDispatcher: UiActionDispatcher | undefined = options.uiActionDispatcher ?? (journalStore ? {\\n@@\\n   let settle: ((result: OpenTuiExitResult) => void) | null = null;\\n   let settled = false;\\n+  let detachRecoveryEvents: (() => void) | undefined;\\n@@\\n     onDestroy: () => {\\n+      detachRecoveryEvents?.();\\n@@\\n   const surface: HostSurface = {\\n@@\\n   };\\n+  let terminalResponseError: string | null = null;\\n+  detachRecoveryEvents = client.onEvent((event) => {\\n+    const candidate = event as {\\n+      type?: string;\\n+      message?: { role?: string; stopReason?: string; errorMessage?: string };\\n+    } | null;\\n+    if (!candidate || typeof candidate !== \\\"object\\\") return;\\n+    if (candidate.type === \\\"agent_start\\\") {\\n+      terminalResponseError = null;\\n+      return;\\n+    }\\n+    if (candidate.type === \\\"message_end\\\" && candidate.message?.role === \\\"assistant\\\") {\\n+      terminalResponseError = candidate.message.stopReason === \\\"error\\\" || candidate.message.stopReason === \\\"aborted\\\"\\n+        ? candidate.message.errorMessage || candidate.message.stopReason\\n+        : null;\\n+      return;\\n+    }\\n+    if (candidate.type !== \\\"agent_end\\\") return;\\n+    if (!terminalResponseError) {\\n+      promptRecovery.completePending();\\n+      return;\\n+    }\\n+    const restored = promptRecovery.failPending();\\n+    if (restored === null) return;\\n+    input.value = restored;\\n+    appendEntry({\\n+      id: `provider-recovery-${Date.now()}`,\\n+      kind: \\\"notice\\\",\\n+      title: \\\"Exact draft restored\\\",\\n+      body: `${sanitizeDiagnostic(terminalResponseError)}\\\\n\\\\nEdit the restored composer text, press Ctrl+R to retry, open /settings, or use /shell with this same session.`,\\n+    });\\n+    status.content = \\\"Provider response failed. Exact draft restored · Ctrl+R retries · /settings or /shell repairs access.\\\";\\n+  });\\n   const controller = new HostController(client, surface, { uiActionDispatcher });\\n*** Update File: /home/diogenes/Projects/keating/test/tui-terminal-presentation.test.ts\\n@@\\n   test(\\\"uses the follow-up transport while busy and reports an empty retry truthfully\\\", async () => {\\n@@\\n     expect(await recovery.retry(false)).toEqual({ ok: false, message: null, error: null });\\n     expect(await recovery.send(\\\"queued\\\", true)).toEqual({ ok: true, message: \\\"queued\\\" });\\n+    expect(recovery.pendingDraft).toBe(\\\"queued\\\");\\n+    expect(recovery.completePending()).toBe(\\\"queued\\\");\\n+    expect(recovery.pendingDraft).toBeNull();\\n     expect(followUps).toEqual([\\\"queued\\\"]);\\n   });\\n+\\n+  test(\\\"restores an RPC-accepted draft when the provider fails asynchronously\\\", async () => {\\n+    const recovery = new TuiPromptRecovery({\\n+      async prompt() {},\\n+      async followUp() {},\\n+    });\\n+\\n+    expect(await recovery.send(\\\"exact accepted draft\\\", false)).toEqual({ ok: true, message: \\\"exact accepted draft\\\" });\\n+    expect(recovery.draft).toBeNull();\\n+    expect(recovery.pendingDraft).toBe(\\\"exact accepted draft\\\");\\n+    expect(recovery.failPending()).toBe(\\\"exact accepted draft\\\");\\n+    expect(recovery.draft).toBe(\\\"exact accepted draft\\\");\\n+    expect(recovery.pendingDraft).toBeNull();\\n+    expect(await recovery.retry(false)).toEqual({ ok: true, message: \\\"exact accepted draft\\\" });\\n+    expect(recovery.pendingDraft).toBe(\\\"exact accepted draft\\\");\\n+  });\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467"}}}
