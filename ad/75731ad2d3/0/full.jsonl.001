me;\\n+}\\n@@\\n \\treturn {\\n-\\t\\tstoreName: requireString(params, \\\"storeName\\\", MAX_STORE_NAME_LENGTH),\\n+\\t\\tstoreName: requireReplicatedStoreName(params),\\n@@\\n-\\t\\t\\t\\tstore: assertBoundedName(candidate[\\\"store\\\"], \\\"RPC store\\\", MAX_STORE_NAME_LENGTH),\\n+\\t\\t\\t\\tstore: (() => {\\n+\\t\\t\\t\\t\\tconst store = assertBoundedName(candidate[\\\"store\\\"], \\\"RPC store\\\", MAX_STORE_NAME_LENGTH);\\n+\\t\\t\\t\\t\\tif (store === PROVIDER_KEYS_STORE) throw new IpcValidationError(\\\"Provider credentials require secure credential storage.\\\");\\n+\\t\\t\\t\\t\\treturn store;\\n+\\t\\t\\t\\t})(),\\n@@\\n-\\t\\t\\t\\tstore: assertBoundedName(candidate[\\\"store\\\"], \\\"RPC store\\\", MAX_STORE_NAME_LENGTH),\\n+\\t\\t\\t\\tstore: (() => {\\n+\\t\\t\\t\\t\\tconst store = assertBoundedName(candidate[\\\"store\\\"], \\\"RPC store\\\", MAX_STORE_NAME_LENGTH);\\n+\\t\\t\\t\\t\\tif (store === PROVIDER_KEYS_STORE) throw new IpcValidationError(\\\"Provider credentials require secure credential storage.\\\");\\n+\\t\\t\\t\\t\\treturn store;\\n+\\t\\t\\t\\t})(),\\n@@\\n-\\t\\t\\t\\t\\tconst storeName = requireString(params, \\\"storeName\\\", MAX_STORE_NAME_LENGTH);\\n+\\t\\t\\t\\t\\tconst storeName = requireReplicatedStoreName(params);\\n@@\\n-\\t\\t\\t\\t\\t\\trequireString(params, \\\"storeName\\\", MAX_STORE_NAME_LENGTH),\\n+\\t\\t\\t\\t\\t\\trequireReplicatedStoreName(params),\\n@@\\n-\\t\\t\\t\\t\\t\\trequireString(params, \\\"storeName\\\", MAX_STORE_NAME_LENGTH),\\n+\\t\\t\\t\\t\\t\\trequireReplicatedStoreName(params),\\n@@\\n-\\t\\t\\t\\t\\tawait backend.clear(requireString(params, \\\"storeName\\\", MAX_STORE_NAME_LENGTH));\\n+\\t\\t\\t\\t\\tawait backend.clear(requireReplicatedStoreName(params));\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b"}}}
{"timestamp":"2026-08-11T10:48:43.463Z","type":"event_msg","payload":{"type":"patch_apply_end","call_id":"exec-666fc533-1e77-40bc-9270-378516d0473f","turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b","stdout":"Success. Updated the following files:\nA /home/diogenes/Projects/keating/desktop/src/credential-ipc.ts\nM /home/diogenes/Projects/keating/desktop/src/preload.cts\nM /home/diogenes/Projects/keating/desktop/src/main.ts\nM /home/diogenes/Projects/keating/desktop/src/ipc.ts\n","stderr":"","success":true,"changes":{"/home/diogenes/Projects/keating/desktop/src/preload.cts":{"type":"update","unified_diff":"@@ -12,2 +12,3 @@\n const P2P_EVENT_CHANNEL = \"keating:p2p:event\";\n+const CREDENTIAL_IPC_CHANNEL = \"keating:credentials:rpc\";\n \n@@ -24,2 +25,11 @@\n \n+export interface KeatingCredentialBridge {\n+  get(id: string): Promise<string | null>;\n+  set(id: string, value: string): Promise<void>;\n+  delete(id: string): Promise<void>;\n+  keys(): Promise<string[]>;\n+  has(id: string): Promise<boolean>;\n+  clear(): Promise<void>;\n+}\n+\n let seq = 0;\n@@ -58 +68,23 @@\n contextBridge.exposeInMainWorld(\"keatingP2P\", bridge);\n+\n+async function credentialCall<T>(method: string, params?: Record<string, unknown>): Promise<T> {\n+  const id = `credential-${Date.now()}-${seq++}`;\n+  const response = (await ipcRenderer.invoke(CREDENTIAL_IPC_CHANNEL, {\n+    id,\n+    method,\n+    params: jsonCompatibleParams(params),\n+  })) as { ok: boolean; result?: T; error?: { message?: string } };\n+  if (!response.ok) throw new Error(response.error?.message ?? \"Secure credential storage failed\");\n+  return response.result as T;\n+}\n+\n+const credentialBridge: KeatingCredentialBridge = {\n+  get: (id) => credentialCall(\"get\", { id }),\n+  set: (id, value) => credentialCall(\"set\", { id, value }),\n+  delete: (id) => credentialCall(\"delete\", { id }),\n+  keys: () => credentialCall(\"keys\"),\n+  has: (id) => credentialCall(\"has\", { id }),\n+  clear: () => credentialCall(\"clear\"),\n+};\n+\n+contextBridge.exposeInMainWorld(\"keatingCredentials\", credentialBridge);\n","move_path":null},"/home/diogenes/Projects/keating/desktop/src/credential-ipc.ts":{"type":"add","content":"import { ipcMain, type BrowserWindow } from \"electron\";\nimport { DesktopCredentialService } from \"./credential-service.js\";\nimport { CredentialVaultError } from \"./credential-vault.js\";\nimport {\n\tassertAllowedParams,\n\tassertBoundedName,\n\tassertPlainParams,\n\tcreateRequestIdTracker,\n\tIpcValidationError,\n\tisTrustedAppNavigation,\n\tMAX_KEY_LENGTH,\n\tMAX_RPC_ID_LENGTH,\n\tMAX_RPC_NAME_LENGTH,\n} from \"./security.js\";\n\nexport const CREDENTIAL_IPC_CHANNEL = \"keating:credentials:rpc\";\n\nconst CREDENTIAL_METHODS = new Set([\"get\", \"set\", \"delete\", \"keys\", \"has\", \"clear\"]);\n\ninterface CredentialRequest {\n\tid: string;\n\tmethod: string;\n\tparams?: Record<string, unknown>;\n}\n\ninterface CredentialResponse<T = unknown> {\n\tid: string;\n\tok: boolean;\n\tresult?: T;\n\terror?: { message: string };\n}\n\nlet activeCleanup: (() => void) | null = null;\n\nfunction parseRequest(value: unknown): CredentialRequest {\n\tconst request = assertPlainParams(value);\n\tif (!request) throw new IpcValidationError(\"Credential request is invalid.\");\n\tassertAllowedParams(request, [\"id\", \"method\", \"params\"]);\n\tconst id = assertBoundedName(request[\"id\"], \"Credential request id\", MAX_RPC_ID_LENGTH);\n\tconst method = assertBoundedName(request[\"method\"], \"Credential method\", MAX_RPC_NAME_LENGTH);\n\tif (!CREDENTIAL_METHODS.has(method)) throw new IpcValidationError(\"Credential method is not supported.\");\n\treturn { id, method, params: assertPlainParams(request[\"params\"]) };\n}\n\nfunction credentialId(params: Record<string, unknown> | undefined): string {\n\tassertAllowedParams(params, [\"id\"]);\n\treturn assertBoundedName(params?.[\"id\"], \"Credential id\", MAX_KEY_LENGTH);\n}\n\nfunction safeCredentialError(error: unknown): string {\n\tif (error instanceof IpcValidationError || error instanceof CredentialVaultError) return error.message;\n\tif (error instanceof Error && error.message === \"Legacy credential has an invalid value.\") return error.message;\n\treturn \"Secure credential storage could not complete the request.\";\n}\n\nfunction senderIsAuthorized(\n\tevent: { sender: { id: number; getURL(): string }; senderFrame?: { url: string } | null },\n\twindow: BrowserWindow,\n\tappOrigin: string,\n): boolean {\n\treturn event.sender.id === window.webContents.id\n\t\t&& isTrustedAppNavigation(event.senderFrame?.url ?? event.sender.getURL(), appOrigin);\n}\n\nexport function registerCredentialIpc(\n\twindow: BrowserWindow,\n\tservice: DesktopCredentialService,\n\tappOrigin: string,\n): () => void {\n\tactiveCleanup?.();\n\tconst requestIds = createRequestIdTracker();\n\tlet stopped = false;\n\tconst handle = async (\n\t\tevent: { sender: { id: number; getURL(): string }; senderFrame?: { url: string } | null },\n\t\traw: unknown,\n\t): Promise<CredentialResponse> => {\n\t\tif (stopped || !senderIsAuthorized(event, window, appOrigin)) {\n\t\t\treturn { id: \"\", ok: false, error: { message: \"Credential IPC sender is not authorized.\" } };\n\t\t}\n\t\tlet request: CredentialRequest | undefined;\n\t\ttry {\n\t\t\trequest = parseRequest(raw);\n\t\t\tif (!requestIds.claim(request.id)) {\n\t\t\t\treturn { id: request.id, ok: false, error: { message: \"Credential request id has already been used.\" } };\n\t\t\t}\n\t\t\tconst params = request.params;\n\t\t\tswitch (request.method) {\n\t\t\t\tcase \"get\":\n\t\t\t\t\treturn { id: request.id, ok: true, result: await service.get(credentialId(params)) };\n\t\t\t\tcase \"set\": {\n\t\t\t\t\tassertAllowedParams(params, [\"id\", \"value\"]);\n\t\t\t\t\tconst id = assertBoundedName(params?.[\"id\"], \"Credential id\", MAX_KEY_LENGTH);\n\t\t\t\t\tconst value = params?.[\"value\"];\n\t\t\t\t\tif (typeof value !== \"string\") throw new IpcValidationError(\"Credential value is invalid.\");\n\t\t\t\t\tawait service.set(id, value);\n\t\t\t\t\treturn { id: request.id, ok: true };\n\t\t\t\t}\n\t\t\t\tcase \"delete\":\n\t\t\t\t\tawait service.delete(credentialId(params));\n\t\t\t\t\treturn { id: request.id, ok: true };\n\t\t\t\tcase \"keys\":\n\t\t\t\t\tassertAllowedParams(params, []);\n\t\t\t\t\treturn { id: request.id, ok: true, result: await service.keys() };\n\t\t\t\tcase \"has\":\n\t\t\t\t\treturn { id: request.id, ok: true, result: await service.has(credentialId(params)) };\n\t\t\t\tcase \"clear\":\n\t\t\t\t\tassertAllowedParams(params, []);\n\t\t\t\t\tawait service.clear();\n\t\t\t\t\treturn { id: request.id, ok: true };\n\t\t\t}\n\t\t\tthrow new IpcValidationError(\"Credential method is not supported.\");\n\t\t} catch (error) {\n\t\t\treturn { id: request?.id ?? \"\", ok: false, error: { message: safeCredentialError(error) } };\n\t\t}\n\t};\n\n\tipcMain.handle(CREDENTIAL_IPC_CHANNEL, handle);\n\tconst cleanup = () => {\n\t\tif (stopped) return;\n\t\tstopped = true;\n\t\twindow.removeListener(\"closed\", cleanup);\n\t\tif (activeCleanup === cleanup) {\n\t\t\tactiveCleanup = null;\n\t\t\tipcMain.removeHandler(CREDENTIAL_IPC_CHANNEL);\n\t\t}\n\t};\n\tactiveCleanup = cleanup;\n\twindow.once(\"closed\", cleanup);\n\treturn cleanup;\n}\n"},"/home/diogenes/Projects/keating/desktop/src/ipc.ts":{"type":"update","unified_diff":"@@ -27,2 +27,3 @@\n } from \"./security.js\";\n+import { PROVIDER_KEYS_STORE } from \"./credential-service.js\";\n \n@@ -73,2 +74,12 @@\n \n+function requireReplicatedStoreName(\n+\tparams: Record<string, unknown> | undefined,\n+): string {\n+\tconst storeName = requireString(params, \"storeName\", MAX_STORE_NAME_LENGTH);\n+\tif (storeName === PROVIDER_KEYS_STORE) {\n+\t\tthrow new IpcValidationError(\"Provider credentials require secure credential storage.\");\n+\t}\n+\treturn storeName;\n+}\n+\n function requireOptionalString(\n@@ -85,3 +96,3 @@\n \treturn {\n-\t\tstoreName: requireString(params, \"storeName\", MAX_STORE_NAME_LENGTH),\n+\t\tstoreName: requireReplicatedStoreName(params),\n \t\tkey: requireString(params, \"key\"),\n@@ -113,3 +124,7 @@\n \t\t\t\ttype: \"put\" as const,\n-\t\t\t\tstore: assertBoundedName(candidate[\"store\"], \"RPC store\", MAX_STORE_NAME_LENGTH),\n+\t\t\t\tstore: (() => {\n+\t\t\t\t\tconst store = assertBoundedName(candidate[\"store\"], \"RPC store\", MAX_STORE_NAME_LENGTH);\n+\t\t\t\t\tif (store === PROVIDER_KEYS_STORE) throw new IpcValidationError(\"Provider credentials require secure credential storage.\");\n+\t\t\t\t\treturn store;\n+\t\t\t\t})(),\n \t\t\t\tkey: assertBoundedName(candidate[\"key\"], \"RPC key\", MAX_KEY_LENGTH),\n@@ -122,3 +137,7 @@\n \t\t\t\ttype: \"del\" as const,\n-\t\t\t\tstore: assertBoundedName(candidate[\"store\"], \"RPC store\", MAX_STORE_NAME_LENGTH),\n+\t\t\t\tstore: (() => {\n+\t\t\t\t\tconst store = assertBoundedName(candidate[\"store\"], \"RPC store\", MAX_STORE_NAME_LENGTH);\n+\t\t\t\t\tif (store === PROVIDER_KEYS_STORE) throw new IpcValidationError(\"Provider credentials require secure credential storage.\");\n+\t\t\t\t\treturn store;\n+\t\t\t\t})(),\n \t\t\t\tkey: assertBoundedName(candidate[\"key\"], \"RPC key\", MAX_KEY_LENGTH),\n@@ -171,3 +190,3 @@\n \t\t\t\t\tassertAllowedParams(params, [\"storeName\", \"key\", \"value\"]);\n-\t\t\t\t\tconst storeName = requireString(params, \"storeName\", MAX_STORE_NAME_LENGTH);\n+\t\t\t\t\tconst storeName = requireReplicatedStoreName(params);\n \t\t\t\t\tconst key = requireString(params, \"key\");\n@@ -184,3 +203,3 @@\n \t\t\t\t\treturn ok(id, await backend.keys(\n-\t\t\t\t\t\trequireString(params, \"storeName\", MAX_STORE_NAME_LENGTH),\n+\t\t\t\t\t\trequireReplicatedStoreName(params),\n \t\t\t\t\t\trequireOptionalString(params, \"prefix\"),\n@@ -195,3 +214,3 @@\n \t\t\t\t\treturn ok(id, await backend.getAllFromIndex(\n-\t\t\t\t\t\trequireString(params, \"storeName\", MAX_STORE_NAME_LENGTH),\n+\t\t\t\t\t\trequireReplicatedStoreName(params),\n \t\t\t\t\t\trequireString(params, \"indexName\", MAX_INDEX_NAME_LENGTH),\n@@ -202,3 +221,3 @@\n \t\t\t\t\tassertAllowedParams(params, [\"storeName\"]);\n-\t\t\t\t\tawait backend.clear(requireString(params, \"storeName\", MAX_STORE_NAME_LENGTH));\n+\t\t\t\t\tawait backend.clear(requireReplicatedStoreName(params));\n \t\t\t\t\treturn ok(id, undefined);\n","move_path":null},"/home/diogenes/Projects/keating/desktop/src/main.ts":{"type":"update","unified_diff":"@@ -1,2 +1,2 @@\n-import { app, BrowserWindow, shell } from \"electron\";\n+import { app, BrowserWindow, safeStorage, shell } from \"electron\";\n import { randomBytes } from \"node:crypto\";\n@@ -11,2 +11,5 @@\n import { registerP2PIpc, type P2PBackendBridge } from \"./ipc.js\";\n+import { registerCredentialIpc } from \"./credential-ipc.js\";\n+import { DesktopCredentialService } from \"./credential-service.js\";\n+import { CredentialVault } from \"./credential-vault.js\";\n import {\n@@ -149,2 +152,20 @@\n \t\tconst rendererCleanups = [registerP2PIpc(window, bridge, { appOrigin: renderer.origin })];\n+\t\tconst credentials = new CredentialVault({\n+\t\t\tpath: join(app.getPath(\"userData\"), \"credentials.v1.json\"),\n+\t\t\tcodec: {\n+\t\t\t\tisEncryptionAvailable() {\n+\t\t\t\t\tif (!safeStorage.isEncryptionAvailable()) return false;\n+\t\t\t\t\tif (process.platform !== \"linux\") return true;\n+\t\t\t\t\tconst backend = safeStorage.getSelectedStorageBackend();\n+\t\t\t\t\treturn backend !== \"basic_text\" && backend !== \"unknown\";\n+\t\t\t\t},\n+\t\t\t\tencryptString: (plaintext) => safeStorage.encryptString(plaintext),\n+\t\t\t\tdecryptString: (ciphertext) => safeStorage.decryptString(Buffer.from(ciphertext)),\n+\t\t\t},\n+\t\t});\n+\t\trendererCleanups.push(registerCredentialIpc(\n+\t\t\twindow,\n+\t\t\tnew DesktopCredentialService(credentials, bridge),\n+\t\t\trenderer.origin,\n+\t\t));\n \t\t// Replacing the lifecycle binding first clears handlers from a prior macOS\n","move_path":null}},"status":"completed"}}
