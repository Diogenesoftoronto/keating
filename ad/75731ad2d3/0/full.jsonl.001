ager.get_full_repo_contents_at_repo_state)(self.base_commit, self.diff)\n           ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/diogenes/.local/share/uv/tools/verify-everything/lib64/python3.13/site-packages/vet/imbue_core/async_utils.py\", line 21, in wrapper\n    return asyncio.run_coroutine_threadsafe(func(*args, **kwargs), loop).result()\n           ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~^^\n  File \"/usr/lib64/python3.13/concurrent/futures/_base.py\", line 456, in result\n    return self.__get_result()\n           ~~~~~~~~~~~~~~~~~^^\n  File \"/usr/lib64/python3.13/concurrent/futures/_base.py\", line 401, in __get_result\n    raise self._exception\n  File \"/home/diogenes/.local/share/uv/tools/verify-everything/lib64/python3.13/site-packages/vet/imbue_tools/repo_utils/context_retrieval.py\", line 47, in get_full_repo_contents_at_repo_state\n    final_contents = await apply_diffs_to_files(final_contents, (diff,))\n                     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/diogenes/.local/share/uv/tools/verify-everything/lib64/python3.13/site-packages/async_lru/__init__.py\", line 287, in __call__\n    return await self._shield_and_handle_cancelled_error(cache_item, key)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/diogenes/.local/share/uv/tools/verify-everything/lib64/python3.13/site-packages/async_lru/__init__.py\", line 241, in _shield_and_handle_cancelled_error\n    return await asyncio.shield(task)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/home/diogenes/.local/share/uv/tools/verify-everything/lib64/python3.13/site-packages/vet/imbue_tools/repo_utils/diff_utils.py\", line 23, in apply_diffs_to_files\n    files_with_diffs = await _apply_diff_to_files(file_contents=files_with_diffs, diff_string=diff_string)\n                       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^