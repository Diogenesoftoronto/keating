\\u001b[49m      \\u001b[2;1H\\u001b[39m\\u001b[49mCtrl+P commands · Ctrl+S sessions · /shell classic Pi\\u001b[0m\\u001b[2;54H\\u001b[38;2;255;255;255m\\u001b[49m                           \\u001b[3;1H\\u001b[39m\\u001b[49m+------------------------------------------------------------------------------+\\u001b[4;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[4;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[4;80H\\u001b[39m\\u001b[49m|\\u001b[5;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[5;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[5;80H\\u001b[39m\\u001b[49m|\\u001b[6;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[6;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[6;80H\\u001b[39m\\u001b[49m|\\u001b[7;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[7;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[7;80H\\u001b[39m\\u001b[49m|\\u001b[8;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[8;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[8;80H\\u001b[39m\\u001b[49m|\\u001b[9;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[9;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[9;80H\\u001b[39m\\u001b[49m|\\u001b[10;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[10;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[10;80H\\u001b[39m\\u001b[49m|\\u001b[11;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[11;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[11;80H\\u001b[39m\\u001b[49m|\\u001b[12;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[12;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[12;80H\\u001b[39m\\u001b[49m|\\u001b[13;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[13;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[13;80H\\u001b[39m\\u001b[49m|\\u001b[14;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[14;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[14;80H\\u001b[39m\\u001b[49m|\\u001b[15;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[15;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[15;80H\\u001b[39m\\u001b[49m|\\u001b[16;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[16;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[16;80H\\u001b[39m\\u001b[49m|\\u001b[17;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[17;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[17;80H\\u001b[39m\\u001b[49m|\\u001b[18;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[18;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[18;80H\\u001b[39m\\u001b[49m|\\u001b[19;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[19;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[19;80H\\u001b[39m\\u001b[49m|\\u001b[20;1H\\u001b[39m\\u001b[49m|\\u001b[0m\\u001b[20;2H\\u001b[38;2;255;255;255m\\u001b[49m                                                                              \\u001b[0m\\u001b[20;