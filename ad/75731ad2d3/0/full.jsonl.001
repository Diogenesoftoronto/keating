{"timestamp":"2026-08-11T11:20:26.564Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_02b258e8e56f2fcd016a7b056ee6c08190bf67cbd391b780f3","status":"completed","call_id":"call_Mg9CPTF0PZTQsD7CnQZCjqGJ","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Update File: /home/diogenes/Projects/keating/packages/learner-contracts/src/rendering.ts\\n@@\\n export function detectSupportedMermaidGrammar(source: string): WebMermaidGrammar | null {\\n-  const header = source.split(/\\\\r?\\\\n/, 1)[0]?.trim() ?? \\\"\\\";\\n-  if (/^flowchart\\\\s+(?:TD|TB|BT|LR|RL)$/u.test(header)) return \\\"flowchart\\\";\\n+  const lines = source.split(/\\\\r?\\\\n/);\\n+  let header = \\\"\\\";\\n+  for (const line of lines) {\\n+    const candidate = line.trim();\\n+    if (!candidate) continue;\\n+    // Initialization directives can alter rendering/security configuration and\\n+    // are never part of the portable contract. Ordinary Mermaid comments are.\\n+    if (/^%%\\\\s*\\\\{/u.test(candidate)) return null;\\n+    if (/^%%/u.test(candidate)) continue;\\n+    header = candidate.split(\\\";\\\", 1)[0]?.trim() ?? \\\"\\\";\\n+    break;\\n+  }\\n+  if (/^(?:graph|flowchart)\\\\s+(?:TD|TB|BT|LR|RL)$/u.test(header)) return \\\"flowchart\\\";\\n*** Update File: /home/diogenes/Projects/keating/packages/learner-contracts/test/rendering-fixtures.test.ts\\n@@\\n-    expect(detectSupportedMermaidGrammar(\\\"graph TD\\\\n  A --> B\\\")).toBeNull();\\n+    expect(detectSupportedMermaidGrammar(\\\"graph TD\\\\n  A --> B\\\")).toBe(\\\"flowchart\\\");\\n+    expect(detectSupportedMermaidGrammar(\\\"graph LR; A --> B\\\")).toBe(\\\"flowchart\\\");\\n+    expect(detectSupportedMermaidGrammar(\\\"%% learner map\\\\nflowchart TB\\\\n  A --> B\\\")).toBe(\\\"flowchart\\\");\\n+    expect(detectSupportedMermaidGrammar(\\\"%%{init: { 'theme': 'forest' }}%%\\\\nflowchart LR\\\\n  A --> B\\\")).toBeNull();\\n*** Update File: /home/diogenes/Projects/keating/mobile/src/lib/local-rich-renderer.ts\\n@@\\n-import { WEB_MERMAID_GRAMMARS, type MermaidParityFixture } from \\\"@keating/learner-contracts\\\";\\n+import {\\n+  WEB_MERMAID_GRAMMARS,\\n+  detectSupportedMermaidGrammar,\\n+  type MermaidParityFixture,\\n+} from \\\"@keating/learner-contracts\\\";\\n@@\\n-function mermaidHeader(source: string): MermaidGrammar | null {\\n-  const header = source.split(/\\\\r?\\\\n/, 1)[0]?.trim() ?? \\\"\\\";\\n-  if (/^flowchart\\\\s+(?:TD|TB|BT|LR|RL)$/u.test(header)) return \\\"flowchart\\\";\\n-  if (header === \\\"sequenceDiagram\\\") return \\\"sequence\\\";\\n-  if (header === \\\"classDiagram\\\") return \\\"class\\\";\\n-  if (header === \\\"stateDiagram\\\" || header === \\\"stateDiagram-v2\\\") return \\\"state\\\";\\n-  if (header === \\\"erDiagram\\\") return \\\"er\\\";\\n-  if (header === \\\"gantt\\\") return \\\"gantt\\\";\\n-  if (/^pie(?:\\\\s+title(?:\\\\s+.+)?)?$/u.test(header)) return \\\"pie\\\";\\n-  if (header === \\\"mindmap\\\") return \\\"mindmap\\\";\\n-  if (header === \\\"timeline\\\") return \\\"timeline\\\";\\n-  if (header === \\\"journey\\\") return \\\"journey\\\";\\n-  if (header === \\\"gitGraph\\\") return \\\"gitGraph\\\";\\n-  if (header === \\\"quadrantChart\\\") return \\\"quadrantChart\\\";\\n-  return null;\\n-}\\n-\\n export function validateLocalMermaidSource(source: string): RichSourceValidation<MermaidGrammar> {\\n@@\\n-  const kind = mermaidHeader(source);\\n+  const kind = detectSupportedMermaidGrammar(source);\\n*** Update File: /home/diogenes/Projects/keating/mobile/test/mermaid-native.test.ts\\n@@\\n describe(\\\"local Mermaid safety contract\\\", () => {\\n+\\tit(\\\"accepts Keating's generated graph alias and harmless leading comments\\\", () => {\\n+\\t\\texpect(validateLocalMermaidSource(\\\"graph TD; A --> B\\\")).toMatchObject({ ok: true, kind: \\\"flowchart\\\" });\\n+\\t\\texpect(validateLocalMermaidSource(\\\"%% learner map\\\\nflowchart LR\\\\nA --> B\\\")).toMatchObject({ ok: true, kind: \\\"flowchart\\\" });\\n+\\t});\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b"}}}
