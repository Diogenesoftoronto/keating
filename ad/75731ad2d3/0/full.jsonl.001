`openui lifecycle=workspace\\nroot = Explanation({ markdown: \\\"Alpha\\\" })\\n```\")[0];\nweb/src/test/openui-segments.test.ts:121:\t\tconst second = parseOpenUIMessageSegments(\"```openui lifecycle=workspace\\nroot = Explanation({ markdown: \\\"Beta\\\" })\\n```\")[0];\nweb/src/test/openui-segments.test.ts:150:\t\tconst [document] = parseOpenUIMessageSegments(\"```openui lifecycle=forever id=bad/id revision=-1\\nroot = Nope({})\\n```\");\nweb/src/test/openui-segments.test.ts:152:\t\texpect(document.metadata.lifecycle).toBe(\"ephemeral\");\nweb/src/test/course-assembly.test.ts:104:                \"```openui lifecycle=workspace id=systems-plan\",\nweb/src/test/course-assembly.test.ts:189:              text: `${quizTag}\\n${imageTag}\\n\\`\\`\\`openui lifecycle=workspace id=surface-1\\nroot = Explanation(\\\"A model\\\", \\\"Generated surface\\\")\\n\\`\\`\\``,\nweb/src/test/lifecycle.test.ts:2:import { KeatingLifecycle } from \"../keating/lifecycle\";\nweb/src/test/lifecycle.test.ts:6:\t\tconst lifecycle = new KeatingLifecycle();\nweb/src/test/lifecycle.test.ts:8:\t\tlifecycle.on(\"session_start\", async (event) => { calls.push(`first:${event.sessionId}`); });\nweb/src/test/lifecycle.test.ts:9:\t\tlifecycle.on(\"session_start\", async () => { calls.push(\"second\"); });\nweb/src/test/lifecycle.test.ts:11:\t\tconst errors = await lifecycle.emit({ type: \"session_start\", sessionId: \"session-1\" });\nweb/src/test/lifecycle.test.ts:17:\t\tconst lifecycle = new KeatingLifecycle();\nweb/src/test/lifecycle.test.ts:19:\t\tlifecycle.on(\"session_idle\", async () => { throw new Error(\"observer failed\"); });\nweb/src/test/lifecycle.test.ts:20:\t\tconst unsubscribe = lifecycle.on(\"session_idle\", async () => { completed += 1; });\nweb/src/test/lifecycle.test.ts:22:\t\tconst errors = await lifecycle.emit({ type: \"session_idle\", sessionId: \"session-1\" });\nweb/src/test/lifecycle.test.ts:27:\t\tawait lifecycle.emit({ type: \"session_idle\", sessionId: \"session-1\" });\