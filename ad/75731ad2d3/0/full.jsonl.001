`);\nmobile/test/mermaid-native.test.ts:8:    expect(parseMermaidFlowchart(\"graph TD; A[Known idea] --> B[Bridge]; B -->|test| C{Transfer}\")) .toEqual({\nmobile/test/mermaid-native.test.ts:20:    expect(parseMermaidFlowchart(\"graph TD; click A javascript:alert(1)\")).toBeNull();\nmobile/test/mermaid-native.test.ts:25:    const graph = parseMermaidFlowchart(`graph RL\nmobile/test/mermaid-native.test.ts:37:    expect(parseMermaidFlowchart(\"flowchart BT; A --> B\")?.direction).toBe(\"BT\");\nmobile/test/mermaid-native.test.ts:52:      \"flowchart LR\\n  A --> B\\n  click B https://example.com\",\nmobile/test/mermaid-native.test.ts:60:    expect(validateLocalMermaidSource(`flowchart LR\\n${\"A --> B\\n\".repeat(800)}`).ok).toBe(false);\nmobile/test/mermaid-native.test.ts:61:    expect(validateLocalMermaidSource(`flowchart LR\\n${\"A\".repeat(MAX_MERMAID_SOURCE_LENGTH)}`).ok).toBe(false);\ntest/animation.test.ts:22:      expect(mermaid.startsWith(\"graph TD\")).toBe(true);\nweb/test/mermaid-renderer.test.ts:14:\t\t\t\"graph TD;\",\nweb/test/mermaid-renderer.test.ts:26:\t\t\t{ id: \"mermaid-0\", code: \"graph TD;\\n  A[One] --> B[Two]\\n\" },\nweb/test/mermaid-renderer.test.ts:35:\t\texpect(mermaidSourceError(\"flowchart LR\\n  A --> B\")).toBeNull();\nweb/test/mermaid-renderer.test.ts:39:\t\tconst sharedPrefix = `flowchart LR\\n${\"A --> B\\n\".repeat(40)}`;\nsrc/core/project.ts:516:    \"flowchart TD\",\nweb/src/test/course-assembly.test.ts:225:          mmdContent: \"graph LR; A-->B\",\nsrc/core/map.ts:17:    \"graph TD\",\nweb/src/test/openui-segments.test.ts:30:\t\t\t\"```openui lifecycle=workspace id=map-1\\nroot = ConceptMap({ code: \\\"graph TD\",\nweb/src/test/openui-segments.test.ts:36:\t\texpect(document.rawProgram).toContain(\"graph TD\");\nweb/src/keating/core.ts:878:\treturn `graph TD\nweb/src/test/course-operations.test.ts:378:      content: \"graph LR; A-->B\",\nweb/src/test/course-operations.test.ts:397:    expect(removed.artifacts[0]?.content).toBe(\