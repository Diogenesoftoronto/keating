{"timestamp":"2026-08-11T10:49:58.778Z","type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_02b258e8e56f2fcd016a7afe3f14e88190954815c99e07c6c9","status":"completed","call_id":"call_oNwz2rhCqprFjBf5Rha4FodI","name":"exec","input":"const patch = \"*** Begin Patch\\n*** Update File: /home/diogenes/Projects/keating/web/src/lib/p2p-storage-backend.ts\\n@@\\n export interface KeatingP2PBridge {\\n@@\\n }\\n+\\n+export interface KeatingCredentialBridge {\\n+\\tget(id: string): Promise<string | null>;\\n+\\tset(id: string, value: string): Promise<void>;\\n+\\tdelete(id: string): Promise<void>;\\n+\\tkeys(): Promise<string[]>;\\n+\\thas(id: string): Promise<boolean>;\\n+\\tclear(): Promise<void>;\\n+}\\n@@\\n \\tinterface Window {\\n \\t\\tkeatingP2P?: KeatingP2PBridge;\\n+\\t\\tkeatingCredentials?: KeatingCredentialBridge;\\n \\t}\\n }\\n+\\n+const PROVIDER_KEYS_STORE = \\\"provider-keys\\\";\\n+\\n+function detectedCredentialBridge(): KeatingCredentialBridge | undefined {\\n+\\treturn typeof window === \\\"undefined\\\" ? undefined : window.keatingCredentials;\\n+}\\n@@\\n export class P2PStorageBackend implements StorageBackend {\\n \\treadonly kind = \\\"p2p\\\" as const;\\n-\\tconstructor(private readonly bridge: KeatingP2PBridge) {}\\n+\\tconstructor(\\n+\\t\\tprivate readonly bridge: KeatingP2PBridge,\\n+\\t\\tprivate readonly credentials: KeatingCredentialBridge | undefined = detectedCredentialBridge(),\\n+\\t) {}\\n+\\n+\\tprivate credentialBridge(): KeatingCredentialBridge {\\n+\\t\\tif (!this.credentials) {\\n+\\t\\t\\tthrow new Error(\\\"Secure desktop credential storage is unavailable. Restart Keating or use Settings to recover.\\\");\\n+\\t\\t}\\n+\\t\\treturn this.credentials;\\n+\\t}\\n \\n \\tget<T = unknown>(storeName: string, key: string): Promise<T | null> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) {\\n+\\t\\t\\treturn this.credentialBridge().get(key) as Promise<T | null>;\\n+\\t\\t}\\n \\t\\treturn this.bridge.call<T | null>(\\\"get\\\", { storeName, key });\\n \\t}\\n \\n \\tset<T = unknown>(storeName: string, key: string, value: T): Promise<void> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) {\\n+\\t\\t\\tif (typeof value !== \\\"string\\\") return Promise.reject(new Error(\\\"Desktop credentials must be strings.\\\"));\\n+\\t\\t\\treturn this.credentialBridge().set(key, value);\\n+\\t\\t}\\n \\t\\treturn this.bridge.call<void>(\\\"set\\\", { storeName, key, value });\\n \\t}\\n \\n \\tdelete(storeName: string, key: string): Promise<void> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().delete(key);\\n \\t\\treturn this.bridge.call<void>(\\\"delete\\\", { storeName, key });\\n \\t}\\n \\n \\tkeys(storeName: string, prefix?: string): Promise<string[]> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) {\\n+\\t\\t\\treturn this.credentialBridge().keys().then((keys) => prefix ? keys.filter((key) => key.startsWith(prefix)) : keys);\\n+\\t\\t}\\n \\t\\treturn this.bridge.call<string[]>(\\\"keys\\\", { storeName, prefix });\\n \\t}\\n@@\\n \\t): Promise<T[]> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) {\\n+\\t\\t\\treturn Promise.reject(new Error(\\\"Secure desktop credentials do not expose secondary indexes.\\\"));\\n+\\t\\t}\\n \\t\\treturn this.bridge.call<T[]>(\\\"getAllFromIndex\\\", {\\n@@\\n \\tclear(storeName: string): Promise<void> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().clear();\\n \\t\\treturn this.bridge.call<void>(\\\"clear\\\", { storeName });\\n \\t}\\n \\n \\thas(storeName: string, key: string): Promise<boolean> {\\n+\\t\\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().has(key);\\n \\t\\treturn this.bridge.call<boolean>(\\\"has\\\", { storeName, key });\\n@@\\n \\t\\t};\\n \\t\\tconst result = await operation(tx);\\n \\t\\tif (mode === \\\"readwrite\\\" && mutations.length > 0) {\\n+\\t\\t\\tif (mutations.some((mutation) => mutation.store === PROVIDER_KEYS_STORE)) {\\n+\\t\\t\\t\\tthrow new Error(\\\"Secure desktop credentials must be changed through the provider settings store, not a mixed transaction.\\\");\\n+\\t\\t\\t}\\n \\t\\t\\tawait this.bridge.call<void>(\\\"batch\\\", { mutations });\\n*** Add File: /home/diogenes/Projects/keating/web/src/test/p2p-storage-backend.test.ts\\n+import { describe, expect, test } from \\\"bun:test\\\";\\n+import {\\n+\\tP2PStorageBackend,\\n+\\ttype KeatingCredentialBridge,\\n+\\ttype KeatingP2PBridge,\\n+} from \\\"../lib/p2p-storage-backend\\\";\\n+\\n+function harness(withCredentials = true) {\\n+\\tconst p2pCalls: Array<{ method: string; params?: Record<string, unknown> }> = [];\\n+\\tconst secrets = new Map<string, string>();\\n+\\tconst p2p: KeatingP2PBridge = {\\n+\\t\\tasync call(method, params) {\\n+\\t\\t\\tp2pCalls.push({ method, params });\\n+\\t\\t\\tif (method === \\\"get\\\") return \\\"p2p-value\\\" as never;\\n+\\t\\t\\tif (method === \\\"keys\\\") return [\\\"p2p-key\\\"] as never;\\n+\\t\\t\\tif (method === \\\"has\\\") return true as never;\\n+\\t\\t\\treturn undefined as never;\\n+\\t\\t},\\n+\\t\\tonPeerStats: () => () => {},\\n+\\t};\\n+\\tconst credentials: KeatingCredentialBridge | undefined = withCredentials ? {\\n+\\t\\tasync get(id) { return secrets.get(id) ?? null; },\\n+\\t\\tasync set(id, value) { secrets.set(id, value); },\\n+\\t\\tasync delete(id) { secrets.delete(id); },\\n+\\t\\tasync keys() { return [...secrets.keys()].sort(); },\\n+\\t\\tasync has(id) { return secrets.has(id); },\\n+\\t\\tasync clear() { secrets.clear(); },\\n+\\t} : undefined;\\n+\\treturn { backend: new P2PStorageBackend(p2p, credentials), p2pCalls, secrets };\\n+}\\n+\\n+describe(\\\"desktop hybrid storage boundary\\\", () => {\\n+\\ttest(\\\"routes all provider and OAuth credentials away from replicated P2P storage\\\", async () => {\\n+\\t\\tconst h = harness();\\n+\\t\\tawait h.backend.set(\\\"provider-keys\\\", \\\"openai\\\", \\\"sk-secret\\\");\\n+\\t\\tawait h.backend.set(\\\"provider-keys\\\", \\\"oauth:anthropic\\\", \\\"oauth-secret\\\");\\n+\\t\\texpect(await h.backend.get(\\\"provider-keys\\\", \\\"openai\\\")).toBe(\\\"sk-secret\\\");\\n+\\t\\texpect(await h.backend.has(\\\"provider-keys\\\", \\\"oauth:anthropic\\\")).toBe(true);\\n+\\t\\texpect(await h.backend.keys(\\\"provider-keys\\\", \\\"oauth:\\\")).toEqual([\\\"oauth:anthropic\\\"]);\\n+\\t\\tawait h.backend.delete(\\\"provider-keys\\\", \\\"openai\\\");\\n+\\t\\texpect(h.secrets.has(\\\"openai\\\")).toBe(false);\\n+\\t\\tawait h.backend.clear(\\\"provider-keys\\\");\\n+\\t\\texpect(h.secrets.size).toBe(0);\\n+\\t\\texpect(h.p2pCalls).toEqual([]);\\n+\\t});\\n+\\n+\\ttest(\\\"continues routing learner data through the P2P backend\\\", async () => {\\n+\\t\\tconst h = harness();\\n+\\t\\texpect(await h.backend.get(\\\"sessions\\\", \\\"lesson-1\\\")).toBe(\\\"p2p-value\\\");\\n+\\t\\tawait h.backend.set(\\\"settings\\\", \\\"theme\\\", \\\"dark\\\");\\n+\\t\\texpect(h.p2pCalls).toEqual([\\n+\\t\\t\\t{ method: \\\"get\\\", params: { storeName: \\\"sessions\\\", key: \\\"lesson-1\\\" } },\\n+\\t\\t\\t{ method: \\\"set\\\", params: { storeName: \\\"settings\\\", key: \\\"theme\\\", value: \\\"dark\\\" } },\\n+\\t\\t]);\\n+\\t});\\n+\\n+\\ttest(\\\"fails closed instead of falling back to P2P when the secure bridge is missing\\\", async () => {\\n+\\t\\tconst h = harness(false);\\n+\\t\\tawait expect(h.backend.set(\\\"provider-keys\\\", \\\"openai\\\", \\\"must-not-leak\\\")).rejects.toThrow(\\\"unavailable\\\");\\n+\\t\\texpect(h.p2pCalls).toEqual([]);\\n+\\t});\\n+\\n+\\ttest(\\\"rejects provider-key writes through the generic transaction path\\\", async () => {\\n+\\t\\tconst h = harness();\\n+\\t\\tawait expect(h.backend.transaction([\\\"provider-keys\\\"], \\\"readwrite\\\", async (tx) => {\\n+\\t\\t\\tawait tx.set(\\\"provider-keys\\\", \\\"openai\\\", \\\"must-not-bypass\\\");\\n+\\t\\t})).rejects.toThrow(\\\"provider settings store\\\");\\n+\\t\\texpect(h.p2pCalls).toEqual([]);\\n+\\t\\texpect(h.secrets.size).toBe(0);\\n+\\t});\\n+});\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b"}}}
{"timestamp":"2026-08-11T10:49:59.157Z","type":"event_msg","payload":{"type":"patch_apply_end","call_id":"exec-12d5e414-0f3c-4a99-a50d-4fc94c3b47a0","turn_id":"93ef4b9d-3191-46b6-a2c2-3b39e130995b","stdout":"Success. Updated the following files:\nA /home/diogenes/Projects/keating/web/src/test/p2p-storage-backend.test.ts\nM /home/diogenes/Projects/keating/web/src/lib/p2p-storage-backend.ts\n","stderr":"","success":true,"changes":{"/home/diogenes/Projects/keating/web/src/test/p2p-storage-backend.test.ts":{"type":"add","content":"import { describe, expect, test } from \"bun:test\";\nimport {\n\tP2PStorageBackend,\n\ttype KeatingCredentialBridge,\n\ttype KeatingP2PBridge,\n} from \"../lib/p2p-storage-backend\";\n\nfunction harness(withCredentials = true) {\n\tconst p2pCalls: Array<{ method: string; params?: Record<string, unknown> }> = [];\n\tconst secrets = new Map<string, string>();\n\tconst p2p: KeatingP2PBridge = {\n\t\tasync call(method, params) {\n\t\t\tp2pCalls.push({ method, params });\n\t\t\tif (method === \"get\") return \"p2p-value\" as never;\n\t\t\tif (method === \"keys\") return [\"p2p-key\"] as never;\n\t\t\tif (method === \"has\") return true as never;\n\t\t\treturn undefined as never;\n\t\t},\n\t\tonPeerStats: () => () => {},\n\t};\n\tconst credentials: KeatingCredentialBridge | undefined = withCredentials ? {\n\t\tasync get(id) { return secrets.get(id) ?? null; },\n\t\tasync set(id, value) { secrets.set(id, value); },\n\t\tasync delete(id) { secrets.delete(id); },\n\t\tasync keys() { return [...secrets.keys()].sort(); },\n\t\tasync has(id) { return secrets.has(id); },\n\t\tasync clear() { secrets.clear(); },\n\t} : undefined;\n\treturn { backend: new P2PStorageBackend(p2p, credentials), p2pCalls, secrets };\n}\n\ndescribe(\"desktop hybrid storage boundary\", () => {\n\ttest(\"routes all provider and OAuth credentials away from replicated P2P storage\", async () => {\n\t\tconst h = harness();\n\t\tawait h.backend.set(\"provider-keys\", \"openai\", \"sk-secret\");\n\t\tawait h.backend.set(\"provider-keys\", \"oauth:anthropic\", \"oauth-secret\");\n\t\texpect(await h.backend.get(\"provider-keys\", \"openai\")).toBe(\"sk-secret\");\n\t\texpect(await h.backend.has(\"provider-keys\", \"oauth:anthropic\")).toBe(true);\n\t\texpect(await h.backend.keys(\"provider-keys\", \"oauth:\")).toEqual([\"oauth:anthropic\"]);\n\t\tawait h.backend.delete(\"provider-keys\", \"openai\");\n\t\texpect(h.secrets.has(\"openai\")).toBe(false);\n\t\tawait h.backend.clear(\"provider-keys\");\n\t\texpect(h.secrets.size).toBe(0);\n\t\texpect(h.p2pCalls).toEqual([]);\n\t});\n\n\ttest(\"continues routing learner data through the P2P backend\", async () => {\n\t\tconst h = harness();\n\t\texpect(await h.backend.get(\"sessions\", \"lesson-1\")).toBe(\"p2p-value\");\n\t\tawait h.backend.set(\"settings\", \"theme\", \"dark\");\n\t\texpect(h.p2pCalls).toEqual([\n\t\t\t{ method: \"get\", params: { storeName: \"sessions\", key: \"lesson-1\" } },\n\t\t\t{ method: \"set\", params: { storeName: \"settings\", key: \"theme\", value: \"dark\" } },\n\t\t]);\n\t});\n\n\ttest(\"fails closed instead of falling back to P2P when the secure bridge is missing\", async () => {\n\t\tconst h = harness(false);\n\t\tawait expect(h.backend.set(\"provider-keys\", \"openai\", \"must-not-leak\")).rejects.toThrow(\"unavailable\");\n\t\texpect(h.p2pCalls).toEqual([]);\n\t});\n\n\ttest(\"rejects provider-key writes through the generic transaction path\", async () => {\n\t\tconst h = harness();\n\t\tawait expect(h.backend.transaction([\"provider-keys\"], \"readwrite\", async (tx) => {\n\t\t\tawait tx.set(\"provider-keys\", \"openai\", \"must-not-bypass\");\n\t\t})).rejects.toThrow(\"provider settings store\");\n\t\texpect(h.p2pCalls).toEqual([]);\n\t\texpect(h.secrets.size).toBe(0);\n\t});\n});\n"},"/home/diogenes/Projects/keating/web/src/lib/p2p-storage-backend.ts":{"type":"update","unified_diff":"@@ -19,2 +19,11 @@\n \n+export interface KeatingCredentialBridge {\n+\tget(id: string): Promise<string | null>;\n+\tset(id: string, value: string): Promise<void>;\n+\tdelete(id: string): Promise<void>;\n+\tkeys(): Promise<string[]>;\n+\thas(id: string): Promise<boolean>;\n+\tclear(): Promise<void>;\n+}\n+\n declare global {\n@@ -22,2 +31,3 @@\n \t\tkeatingP2P?: KeatingP2PBridge;\n+\t\tkeatingCredentials?: KeatingCredentialBridge;\n \t}\n@@ -25,2 +35,8 @@\n \n+const PROVIDER_KEYS_STORE = \"provider-keys\";\n+\n+function detectedCredentialBridge(): KeatingCredentialBridge | undefined {\n+\treturn typeof window === \"undefined\" ? undefined : window.keatingCredentials;\n+}\n+\n /** True when running inside the Electron desktop shell. */\n@@ -54,5 +70,18 @@\n \treadonly kind = \"p2p\" as const;\n-\tconstructor(private readonly bridge: KeatingP2PBridge) {}\n+\tconstructor(\n+\t\tprivate readonly bridge: KeatingP2PBridge,\n+\t\tprivate readonly credentials: KeatingCredentialBridge | undefined = detectedCredentialBridge(),\n+\t) {}\n \n+\tprivate credentialBridge(): KeatingCredentialBridge {\n+\t\tif (!this.credentials) {\n+\t\t\tthrow new Error(\"Secure desktop credential storage is unavailable. Restart Keating or use Settings to recover.\");\n+\t\t}\n+\t\treturn this.credentials;\n+\t}\n+\n \tget<T = unknown>(storeName: string, key: string): Promise<T | null> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) {\n+\t\t\treturn this.credentialBridge().get(key) as Promise<T | null>;\n+\t\t}\n \t\treturn this.bridge.call<T | null>(\"get\", { storeName, key });\n@@ -61,2 +90,6 @@\n \tset<T = unknown>(storeName: string, key: string, value: T): Promise<void> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) {\n+\t\t\tif (typeof value !== \"string\") return Promise.reject(new Error(\"Desktop credentials must be strings.\"));\n+\t\t\treturn this.credentialBridge().set(key, value);\n+\t\t}\n \t\treturn this.bridge.call<void>(\"set\", { storeName, key, value });\n@@ -65,2 +98,3 @@\n \tdelete(storeName: string, key: string): Promise<void> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().delete(key);\n \t\treturn this.bridge.call<void>(\"delete\", { storeName, key });\n@@ -69,2 +103,5 @@\n \tkeys(storeName: string, prefix?: string): Promise<string[]> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) {\n+\t\t\treturn this.credentialBridge().keys().then((keys) => prefix ? keys.filter((key) => key.startsWith(prefix)) : keys);\n+\t\t}\n \t\treturn this.bridge.call<string[]>(\"keys\", { storeName, prefix });\n@@ -77,2 +114,5 @@\n \t): Promise<T[]> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) {\n+\t\t\treturn Promise.reject(new Error(\"Secure desktop credentials do not expose secondary indexes.\"));\n+\t\t}\n \t\treturn this.bridge.call<T[]>(\"getAllFromIndex\", {\n@@ -85,2 +125,3 @@\n \tclear(storeName: string): Promise<void> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().clear();\n \t\treturn this.bridge.call<void>(\"clear\", { storeName });\n@@ -89,2 +130,3 @@\n \thas(storeName: string, key: string): Promise<boolean> {\n+\t\tif (storeName === PROVIDER_KEYS_STORE) return this.credentialBridge().has(key);\n \t\treturn this.bridge.call<boolean>(\"has\", { storeName, key });\n@@ -118,2 +160,5 @@\n \t\tif (mode === \"readwrite\" && mutations.length > 0) {\n+\t\t\tif (mutations.some((mutation) => mutation.store === PROVIDER_KEYS_STORE)) {\n+\t\t\t\tthrow new Error(\"Secure desktop credentials must be changed through the provider settings store, not a mixed transaction.\");\n+\t\t\t}\n \t\t\tawait this.bridge.call<void>(\"batch\", { mutations });\n","move_path":null}},"status":"completed"}}
