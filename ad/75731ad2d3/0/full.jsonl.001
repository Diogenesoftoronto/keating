ing was executed; correct it and retry.\", true, \"correct-input\");\nsrc/tui/ui/adapter.ts:172:function inferredKind(toolName: string, details: Record<string, unknown>): LegacyUiDocumentKind {\nsrc/tui/ui/adapter.ts:188:export function adaptToolResultToUiDocument(toolName: string, result: unknown): UiDocumentAdaptation {\nsrc/tui/ui/adapter.ts:207:export function toolResultToUiDocument(toolName: string, result: unknown): UiDocument {\nsrc/tui/ui/adapter.ts:210:  return canonicalDocument(\"ui-recovery\", 0, \"UI document needs attention\", [\nsrc/tui/ui/adapter.ts:211:    { type: \"callout\", id: \"ui-recovery-message\", tone: \"warning\", title: \"Recoverable UI input\", markdown: adapted.recovery.message },\nsrc/tui/ui/adapter.ts:212:    { type: \"handoff\", id: \"ui-recovery-handoff\", target: \"web\", reason: \"A capable surface can inspect or repair this UI document.\", context: adapted.recovery.code },\nsrc/tui/ui/journal.ts:35:function recovery(\nsrc/tui/ui/journal.ts:41:  return { ok: false, recovery: { code, message, retryable, preserveEnteredWork: true, suggestedAction } };\nsrc/tui/ui/journal.ts:90:    const untrustedAction: unknown = action;\nsrc/tui/ui/journal.ts:92:      return recovery(\"invalid_action\", \"The action has an invalid shared-contract shape. Your entered work was not discarded.\", true, \"correct-input\");\nsrc/tui/ui/journal.ts:97:      return recovery(\"dispatch_failed\", \"This action is already pending. Keep your entered work and retry after the prior request resolves.\", true, \"retry\");\nsrc/tui/ui/journal.ts:104:      return recovery(\"dispatch_failed\", \"The durable action lock could not be acquired. Your entered work is preserved; repair storage and retry.\", true, \"retry\");\nsrc/tui/ui/journal.ts:133:      return recovery(\"dispatch_failed\", \"The saved action journal could not be read. Your entered work is preserved; repair storage and retry.\", true, \"retry\");\nsrc/tui/ui/journal.ts:137:      return recovery(\"idempotency_conflict\", \"The saved action journal is invalid and cannot be replayed safely. Your entered work is preserved.\", false, \"open-capable-surface\");\nsrc/tui/ui/journal.ts:144:        return { ok: true, result: prior.result, replayed: true, recovery: retryRecovery(prior.result) };\nsrc/tui/ui/journal.ts:148:      return recovery(\"idempotency_conflict\", \"This idempotency key was already used for different entered work. Choose a new action key; nothing was overwritten.\", false, \"correct-input\");\nsrc/tui/ui/journal.ts:157:      return recovery(\"stale_document\", \"This action does not apply to the current document revision or lifecycle. Refresh, keep your entered work, and retry.\", retryable, retryable ? \"retry\" : \"correct-input\");\nsrc/tui/ui/journal.ts:166:        return recovery(\"dispatch_failed\", \"The pending action could not be saved, so it was not delivered. Your entered work is preserved.\", true, \"retry\");\nsrc/tui/ui/journal.ts:204:      return recovery(\"dispatch_failed\", \"The action response arrived, but its final receipt could not be saved. Your entered work remains visible; repair storage before retrying.\", false, \"open-capable-surface\");\nsrc/tui/ui/journal.ts:206:    return { ok: true, result, replayed: false, recovery: retryRecovery(result) };\nsrc/tui/ui/filesystem-journal.ts:118:    let candidate: unknown;\nsrc/tui/opentui-host.ts:40:import { TuiPromptRecovery, type TuiPromptSendOutcome } from \"./prompt-recovery.js\";\nsrc/tui/opentui-host.ts:136:      if (!outcome.ok) throw new Error(outcome.recovery.message);\nsrc/tui/opentui-host.ts:733:      } else if (action === \"Prepare /shell provider or code handoff\") {\nsrc/tui/opentui-host.ts:743:      appendEntry({ id: `settings-error-${Date.now()}`, kind: \"error\", title: \"Settings change failed\", body: `${sanitizeDiagnostic(error)}\\n\\nThe prior runtime setting remains in effect. Retry or prepare /shell for provider recovery.` });\nsrc/tui/opentui-host.ts:798:    status.content = \"Message not sent. Exact draft restored · Ctrl+R retries it · /settings or /shell can repair provider access.\";\nsrc/tui/host-controller.ts:73:  onEvent(listener: (event: unknown) => void): unknown;\nsrc/tui/host-controller.ts:74:  getMessages?(): Promise<unknown[]>;\nsrc/tui/host-controller.ts:76:  getState?(): Promise<unknown>;\nsrc/tui/host-controller.ts:77:  cycleModel?(): Promise<{ model: { provider?: string; id?: string }; thinkingLevel?: string } | null>;\nsrc/tui/host-controller.ts:102:  document?: unknown;\nsrc/tui/host-controller.ts:106:function briefArgs(args: unknown): string {\nsrc/tui/host-controller.ts:108:  const entries = Object.entries(args as Record<string, unknown>)\nsrc/tui/host-controller.ts:123:function carriesUiDocument(toolName: string, result: unknown): boolean {\nsrc/tui/host-controller.ts:126:  const outer = result as Record<string, unknown>;\nsrc/tui/host-controller.ts:131:    .some((key) => key in (details as Record<string, unknown>));\nsrc/tui/host-controller.ts:200:  private appendError(title: string, error: unknown): void {\nsrc/tui/host-controller.ts:204:  private applySessionState(raw: unknown): void {\nsrc/tui/host-controller.ts:206:      model?: { provider?: string; id?: string };\nsrc/tui/host-controller.ts:213:    const provider = state.model?.provider;\nsrc/tui/host-controller.ts:215:    const model = [provider, modelId].filter(Boolean).join(\"/\") || \"model unavailable\";\nsrc/tui/host-controller.ts:234:      const model = [result.model.provider, result.model.id].filter(Boolean).join(\"/\");\nsrc/tui/host-controller.ts:385:  private async sendUiResponse(requestId: string, response: Record<string, unknown>): Promise<void> {\nsrc/tui/host-controller.ts:390:  handleEvent(event: unknown): void {\nsrc/tui/host-controller.ts:414:        const { toolName, args } = event as { toolName?: string; args?: unknown };\nsrc/tui/host-controller.ts:422:        const { toolName, result, isError } = event as { toolName?: string; result?: unknown; isError?: boolean };\nsrc/tui/host-controller.ts:434:          this.append(\"error\", \"Interactive document needs attention\", adapted.recovery.message);\nsrc/tui/host-controller.ts:452:        const { document } = event as { document?: unknown };\nsrc/tui/host-controller.ts:461:  private activateUiDocument(candidate: unknown): void {\nsrc/tui/host-controller.ts:464:      this.append(\"error\", \"Interactive document needs attention\", adapted.recovery.message);\nsrc/tui/host-controller.ts:479:  private action(document: UiDocument, nodeId: string, type: UiAction[\"type\"], fields: Record<string, unknown>): UiAction {\nsrc/tui/host-controller.ts:779:        this.append(\"error\", \"Unsupported Pi UI request\", `${request.method || \"unknown\"}. The request was cancelled explicitly.`);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467"}}}
