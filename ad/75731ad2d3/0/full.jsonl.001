t claim it changed its own code.\\\",\\n*** Update File: /home/diogenes/Projects/keating/test/tui-product-surfaces.test.ts\\n@@\\n import { loadTuiReviewDashboard, rateTuiReviewCard } from \\\"../src/tui/review.js\\\";\\n import { tuiRuntimeSettings, tuiSettingsMarkdown } from \\\"../src/tui/settings.js\\\";\\n+import { OPEN_TUI_TOOL_POLICY } from \\\"../src/runtime/tool-policy.js\\\";\\n@@\\n       availableModels: 7,\\n       openUiReceiver: true,\\n+      toolPolicy: OPEN_TUI_TOOL_POLICY,\\n       codeAugmentation: \\\"handoff-required\\\",\\n@@\\n-    expect(markdown).toContain(\\\"does not expose direct source mutation\\\");\\n+    expect(markdown).toContain(\\\"Agent tools: **read, grep, find, ls**\\\");\\n+    expect(markdown).toContain(\\\"command execution: **unavailable**\\\");\\n+    expect(markdown).toContain(\\\"source mutation: **unavailable**\\\");\\n     expect(markdown).toContain(\\\"proposed-diff, confirmation, validation, and rollback\\\");\\n*** Add File: /home/diogenes/Projects/keating/test/runtime-tool-policy.test.ts\\n+import { describe, expect, test } from \\\"bun:test\\\";\\n+\\n+import {\\n+  CLASSIC_PI_TOOL_POLICY,\\n+  OPEN_TUI_TOOL_POLICY,\\n+  runtimeToolList,\\n+} from \\\"../src/runtime/tool-policy.js\\\";\\n+\\n+describe(\\\"surface-specific Pi tool policy\\\", () => {\\n+  test(\\\"keeps OpenTUI read-only until it has a confirmed mutation protocol\\\", () => {\\n+    expect(runtimeToolList(OPEN_TUI_TOOL_POLICY)).toBe(\\\"read,grep,find,ls\\\");\\n+    expect(OPEN_TUI_TOOL_POLICY).toMatchObject({\\n+      read: true,\\n+      execute: false,\\n+      sourceMutation: false,\\n+      recovery: \\\"shell-handoff\\\",\\n+    });\\n+    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\\\"bash\\\");\\n+    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\\\"edit\\\");\\n+    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\\\"write\\\");\\n+  });\\n+\\n+  test(\\\"retains full code tools on the exact-session classic Pi handoff\\\", () => {\\n+    expect(CLASSIC_PI_TOOL_POLICY).toMatchObject({ read: true, execute: true, sourceMutation: true });\\n+    expect(CLASSIC_PI_TOOL_POLICY.tools).toEqual([\\\"read\\\", \\\"bash\\\", \\\"edit\\\", \\\"write\\\", \\\"grep\\\", \\\"find\\\", \\\"ls\\\"]);\\n+  });\\n+});\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\n","internal_chat_message_metadata_passthrough":{"turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467"}}}
{"timestamp":"2026-08-11T10:24:37.044Z","type":"event_msg","payload":{"type":"patch_apply_end","call_id":"exec-03bb3cdc-b3d8-4768-852a-adf83423703c","turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467","stdout":"Success. Updated the following files:\nA /home/diogenes/Projects/keating/test/runtime-tool-policy.test.ts\nM /home/diogenes/Projects/keating/src/tui/settings.ts\nM /home/diogenes/Projects/keating/test/tui-product-surfaces.test.ts\n","stderr":"","success":true,"changes":{"/home/diogenes/Projects/keating/test/tui-product-surfaces.test.ts":{"type":"update","unified_diff":"@@ -17,2 +17,3 @@\n import { tuiRuntimeSettings, tuiSettingsMarkdown } from \"../src/tui/settings.js\";\n+import { OPEN_TUI_TOOL_POLICY } from \"../src/runtime/tool-policy.js\";\n \n@@ -108,2 +109,3 @@\n       openUiReceiver: true,\n+      toolPolicy: OPEN_TUI_TOOL_POLICY,\n       codeAugmentation: \"handoff-required\",\n@@ -111,3 +113,5 @@\n     const markdown = tuiSettingsMarkdown(settings);\n-    expect(markdown).toContain(\"does not expose direct source mutation\");\n+    expect(markdown).toContain(\"Agent tools: **read, grep, find, ls**\");\n+    expect(markdown).toContain(\"command execution: **unavailable**\");\n+    expect(markdown).toContain(\"source mutation: **unavailable**\");\n     expect(markdown).toContain(\"proposed-diff, confirmation, validation, and rollback\");\n","move_path":null},"/home/diogenes/Projects/keating/test/runtime-tool-policy.test.ts":{"type":"add","content":"import { describe, expect, test } from \"bun:test\";\n\nimport {\n  CLASSIC_PI_TOOL_POLICY,\n  OPEN_TUI_TOOL_POLICY,\n  runtimeToolList,\n} from \"../src/runtime/tool-policy.js\";\n\ndescribe(\"surface-specific Pi tool policy\", () => {\n  test(\"keeps OpenTUI read-only until it has a confirmed mutation protocol\", () => {\n    expect(runtimeToolList(OPEN_TUI_TOOL_POLICY)).toBe(\"read,grep,find,ls\");\n    expect(OPEN_TUI_TOOL_POLICY).toMatchObject({\n      read: true,\n      execute: false,\n      sourceMutation: false,\n      recovery: \"shell-handoff\",\n    });\n    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\"bash\");\n    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\"edit\");\n    expect(OPEN_TUI_TOOL_POLICY.tools).not.toContain(\"write\");\n  });\n\n  test(\"retains full code tools on the exact-session classic Pi handoff\", () => {\n    expect(CLASSIC_PI_TOOL_POLICY).toMatchObject({ read: true, execute: true, sourceMutation: true });\n    expect(CLASSIC_PI_TOOL_POLICY.tools).toEqual([\"read\", \"bash\", \"edit\", \"write\", \"grep\", \"find\", \"ls\"]);\n  });\n});\n"},"/home/diogenes/Projects/keating/src/tui/settings.ts":{"type":"update","unified_diff":"@@ -1 +1,3 @@\n+import { OPEN_TUI_TOOL_POLICY, type RuntimeToolPolicy } from \"../runtime/tool-policy.js\";\n+\n export interface TuiRuntimeSettings {\n@@ -9,2 +11,3 @@\n   openUiReceiver: boolean;\n+  toolPolicy: RuntimeToolPolicy;\n   codeAugmentation: \"handoff-required\";\n@@ -37,2 +40,3 @@\n     openUiReceiver: commandNames.includes(\"keating-ui-action-v1\"),\n+    toolPolicy: OPEN_TUI_TOOL_POLICY,\n     codeAugmentation: \"handoff-required\",\n@@ -52,2 +56,3 @@\n     `- Canonical OpenUI receiver: **${settings.openUiReceiver ? \"available\" : \"unavailable\"}**`,\n+    `- Agent tools: **${settings.toolPolicy.tools.join(\", \")}**`,\n     \"\",\n@@ -55,3 +60,4 @@\n     \"\",\n-    \"OpenTUI does not expose direct source mutation. Pi RPC does not enumerate the active read/execute/edit tool policy, and this host has no proposed-diff, confirmation, validation, and rollback surface yet. Use `/shell` for an explicit capable-surface handoff; OpenTUI will not claim it changed its own code.\",\n+    `Read/search: **${settings.toolPolicy.read ? \"available\" : \"unavailable\"}** · command execution: **${settings.toolPolicy.execute ? \"available\" : \"unavailable\"}** · source mutation: **${settings.toolPolicy.sourceMutation ? \"available\" : \"unavailable\"}**.`,\n+    \"OpenTUI does not advertise execution or source-mutation tools because this host has no proposed-diff, confirmation, validation, and rollback surface. Use `/shell` for an exact-session capable-surface handoff; OpenTUI will not claim it changed its own code.\",\n     \"\",\n","move_path":null}},"status":"completed"}}
