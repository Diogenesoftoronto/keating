ckages/learner-contracts/src/rendering.ts:124:  { id: \"mermaid-pie\", grammar: \"pie\", source: \"pie title Study evidence\\n  \\\"Recall\\\" : 40\\n  \\\"Transfer\\\" : 60\" },\npackages/learner-contracts/src/rendering.ts:125:  { id: \"mermaid-mindmap\", grammar: \"mindmap\", source: \"mindmap\\n  root((Bayes))\\n    Prior\\n    Evidence\\n    Posterior\" },\npackages/learner-contracts/src/rendering.ts:126:  { id: \"mermaid-timeline\", grammar: \"timeline\", source: \"timeline\\n  title Learning sequence\\n  Observe : evidence\\n  Explain : model\\n  Retrieve : test\" },\npackages/learner-contracts/src/rendering.ts:127:  { id: \"mermaid-journey\", grammar: \"journey\", source: \"journey\\n  title Learning journey\\n  section Model\\n    Explain: 4: Learner\\n    Retrieve: 5: Learner, Keating\" },\npackages/learner-contracts/src/rendering.ts:128:  { id: \"mermaid-gitgraph\", grammar: \"gitGraph\", source: \"gitGraph\\n  commit id: \\\"lesson\\\"\\n  branch alternative\\n  commit id: \\\"fork\\\"\" },\npackages/learner-contracts/src/rendering.ts:129:  { id: \"mermaid-quadrant\", grammar: \"quadrantChart\", source: \"quadrantChart\\n  title Confidence and evidence\\n  x-axis Low evidence --> High evidence\\n  y-axis Low confidence --> High confidence\\n  Bayes: [0.7, 0.6]\" },\npackages/learner-contracts/src/rendering.ts:311:    id: \"unsafe-openui-directive\",\npackages/learner-contracts/src/rendering.ts:314:    description: \"A source directive that attempts to import a local file and must never execute.\",\npackages/learner-contracts/src/rendering.ts:315:    payload: '```openui lifecycle=workspace id=unsafe-directive\\n@include file:///private/learner-state.json\\nroot = Explanation(\"This directive is unsafe.\")\\n```',\nmobile/src/lib/local-rich-renderer.ts:1:import { WEB_MERMAID_GRAMMARS, type MermaidParityFixture } from \"@keating/learner-contracts\";\nmobile/src/lib/local-rich-renderer.ts:8:type MermaidGrammar = MermaidParityFixture[\"grammar\"];\nmobile/src/