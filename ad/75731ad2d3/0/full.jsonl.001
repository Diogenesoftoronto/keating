n).toContain(\"Topics tracked:** 1\");\ntest/feedback-benchmark.test.ts:10:import { loadLearnerState, recordFeedback, recordQuizResult, saveLearnerState } from \"../src/core/learner-state.js\";\ntest/feedback-benchmark.test.ts:14:  const state = await loadLearnerState(learnerStatePath(workdir));\ntest/feedback-benchmark.test.ts:19:  expect(result.trace.dataSource).toBe(\"learner-feedback-sparse\");\ntest/feedback-benchmark.test.ts:20:  expect(result.trace.realOutcomeCount).toBe(1);\ntest/feedback-benchmark.test.ts:21:  expect(result.trace.learnerCountPerTopic).toBe(1);\ntest/feedback-benchmark.test.ts:22:  expect(result.trace.topicTraces[0]!.topLearners[0]!.learnerId).toBe(\"real-learner\");\ntest/feedback-benchmark.test.ts:23:  expect(result.trace.topicTraces[0]!.topLearners.some((entry) => entry.learnerId.startsWith(\"learner-\"))).toBe(false);\ntest/feedback-benchmark.test.ts:29:  const state = await loadLearnerState(learnerStatePath(workdir));\ntest/feedback-benchmark.test.ts:43:  expect(result.trace.realOutcomeCount).toBe(2);\ntest/feedback-benchmark.test.ts:44:  expect(result.trace.dataSource).toBe(\"learner-feedback-sparse\");\ntest/feedback-benchmark.test.ts:56:  const state = await loadLearnerState(learnerStatePath(workdir));\ntest/feedback-benchmark.test.ts:61:  expect(result.trace.realOutcomeCount).toBe(1);\ntest/feedback-benchmark.test.ts:62:  expect(result.trace.dataSource).toBe(\"learner-feedback-sparse\");\ntest/feedback-benchmark.test.ts:63:  expect(result.trace.topicTraces[0]!.topLearners[0]!.learnerId).toBe(\"real-learner\");\ntest/feedback-benchmark.test.ts:68:  const lowState = await loadLearnerState(learnerStatePath(lowDir));\ntest/feedback-benchmark.test.ts:73:  const highState = await loadLearnerState(learnerStatePath(highDir));\nsrc/tui/opentui-host.ts:599:    status.content = \"Message not sent. Exact draft restored · Ctrl+R retries it · /settings or /shell can repair provider access.\";\ntest/helpers.ts:165:  const trace: BenchmarkTopicTrac