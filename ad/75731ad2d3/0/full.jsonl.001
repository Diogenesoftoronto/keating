{"timestamp":"2026-08-11T10:35:18.891Z","type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_019ff064-15eb-76d2-8507-b167139f6992","call_id":"call_y8M359Qrsfh4dNwqOuFGQlpD","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"      kind: \"notice\",\n      title: \"Exact draft restored\",\n      body: `${sanitizeDiagnostic(terminalResponseError)}\\n\\nEdit the restored composer text, press Ctrl+R to retry, open /settings, or use /shell with this same session.`,\n    });\n    status.content = \"Provider response failed. Exact draft restored · Ctrl+R retries · /settings or /shell repairs access.\";\n  });\n  const controller = new HostController(client, surface, { uiActionDispatcher });\n  controller.attach();\n  await controller.initialize();\n\n  const exitToShell = async () => {\n    settled = true;\n    settle?.({ action: \"shell\", sessionPath: controller.getCurrentSessionPath() || undefined });\n    renderer.destroy();\n    await client.stop();\n  };\n\n  const runCommand = async (command: TuiCommand): Promise<void> => {\n    switch (command.id) {\n      case \"sessions\":\n        await showSessions();\n        return;\n      case \"library\":\n        await showLibrary();\n        return;\n      case \"review\":\n        await showReview();\n        return;\n      case \"settings\":\n        await showSettings();\n        return;\n      case \"model\":\n        await controller.cycleModel();\n        return;\n      case \"thinking\":\n        await controller.cycleThinking();\n        return;\n      case \"new-session\": {\n        const confirmed = entries.length === 0\n          ? true\n          : await surface.presentConfirm(\"Start a new session?\", \"Your current session remains saved and can be reopened in Pi.\");\n        if (confirmed) await controller.newSession();\n        return;\n      }\n      case \"abort\":\n        await controller.abort();\n        return;\n      case \"retry\":\n        await retryLastPrompt();\n        return;\n      case \"shell\":\n        await exitToShell();\n    }\n  };\n\n  const showSessions = async (): Promise<void> => {\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"336fceb4-26f3-465e-89fc-cad66edcf467"}}}
