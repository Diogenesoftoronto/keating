{
  "pi": {
    "runtimePreference": "embedded-only",
    "defaultProvider": "notorganic",
    "defaultModel": "balanced",
    "defaultThinking": "medium",
    "packages": []
  },
  "speech": {
    "enabled": false,
    "defaultVoice": "conversational",
    "steeringModel": "default"
  },
  "debug": {
