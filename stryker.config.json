{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing via Stryker. Uses the command runner because the project's tests run on bun, which has no native Stryker plugin. TypeScript 7 is native and has no JS parseConfigFileTextToJson API; a nonexistent tsconfigFile bypasses TSConfigPreprocessor. Typecheck separately.",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "bun test ./test/*.test.ts"
  },
  "coverageAnalysis": "off",
  "reporters": [
    "json",
    "clear-text"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  },
  "mutate": [
    "src/core/**/*.ts",
    "!src/core/**/*.test.ts",
    "!src/core/**/*.d.ts"
  ],
  "mutator": {
    "excludedMutations": [
      "ArithmeticOperator",
      "ArrayDeclaration",
      "ArrowFunction",
      "AssignmentOperator",
      "BooleanLiteral",
      "ConditionalExpression",
      "EqualityOperator",
      "LogicalOperator",
      "MethodExpression",
      "ObjectLiteral",
      "OptionalChaining",
      "Regex",
      "StringLiteral",
      "UpdateOperator"
    ]
  },
  "timeoutMS": 60000,
  "concurrency": 2,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 60
  },
  "tempDirName": "/tmp/keating-stryker-default",
  "cleanTempDir": true,
  "ignorePatterns": [
    "/.bun-install",
    "/.bun-tmp",
    "/.entire",
    "/.claude",
    "/.keating",
    "/.chrysalis",
    "/.codex",
    "/.crush",
    "/.opencode",
    "/.agents",
    "/.github",
    "/web/.output",
    "/web/dist",
    "/web/node_modules",
    "/data",
    "/video",
    "/analysis",
    "/test/traces",
    "/test/final_dataset.json",
    "/reports",
    "/*.tsbuildinfo"
  ],
  "tsconfigFile": "stryker-no-tsconfig.json",
  "inPlace": false,
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
