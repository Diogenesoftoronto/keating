# Every variable Keating web reads. Values here are non-secret defaults and
# placeholders -- copy to .env.local (gitignored) and fill in the secrets.
#
# Non-secret defaults are also set for the dev shell in ../devenv.nix. Keep the
# two in sync; `devenv tasks run keating:check-env` enforces it.

# --- Analytics -------------------------------------------------------------
# Public project ingest token. Browser ingest is same-origin through /ingest.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Emergency client analytics kill switch.
VITE_POSTHOG_DISABLED=false
# Opt in only when diagnosing analytics; normal development keeps SDK logs quiet.
VITE_POSTHOG_DEBUG=false

# --- Encrypted learner/source sync -----------------------------------------
# Comma-separated relay WebSocket/HTTP origins.
VITE_KEATING_GUN_PEERS=
# Standalone `bun run gun:relay` settings. Put GUN_RELAY_DATA on a persistent volume.
GUN_RELAY_PORT=8765
GUN_RELAY_DATA=.keating/gun-relay/data
GUN_RELAY_PEERS=

# --- Not Organic hosted access ---------------------------------------------
# Public sign-in uses PKCE/DPoP directly with the provider. Checkout and legacy
# server-proxied access have separate gates. The latter also requires a
# NotOrganicSessionAdapter; see src/notorganic-provider/OPERATIONS.md.

# Server-side gate for routes under server/api/notorganic/**.
NOTORGANIC_ENABLED=false
# Client-side gate. While false the hosted UI stays hidden rather than
# rendering controls that cannot work.
VITE_NOTORGANIC_ENABLED=true
VITE_NOTORGANIC_CHECKOUT_ENABLED=false
# Public OAuth/DPoP sign-in. Blank client id and callback use the current HTTPS
# or loopback browser origin. Checkout has a separate gate above.
VITE_NOTORGANIC_PUBLIC_ISSUER=https://api.notorganic.info
VITE_NOTORGANIC_AUTHORIZATION_URL=https://id.notorganic.info/authorize
VITE_NOTORGANIC_CLIENT_ID=
VITE_NOTORGANIC_REDIRECT_URI=
VITE_NOTORGANIC_SCOPE=wallet:read usage:read billing:checkout infer:balanced realtime:connect
# Per-request browser inference ceiling in micro-USD (100000 = $0.10).
VITE_NOTORGANIC_MAX_COST_MICROUSD=100000
# HTTPS gateway origin. No /v1 path, query, or fragment -- the server rejects
# anything else at startup.
NOTORGANIC_ISSUER=https://api.notorganic.info
# Positive per-request reservation ceiling in micro-USD (50000 = $0.05).
NOTORGANIC_MAX_COST_MICROUSD=50000

# --- OAuth -----------------------------------------------------------------
# Optional OAuth broker client overrides.
OAUTH_ANTHROPIC_CLIENT_ID=
OAUTH_OPENAI_CLIENT_ID=
