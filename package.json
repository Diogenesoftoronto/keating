{
  "name": "keating",
  "version": "4.0.16",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "description": "A Pi-powered hyperteacher package with self-improving teaching policies, lesson maps, and animated visual teaching artifacts.",
  "keywords": [
    "pi-package",
    "hyperteacher",
    "education",
    "feynman-style",
    "teaching-agent",
    "ai-education",
    "cognitive-empowerment"
  ],
  "author": "Diogenes of Toronto",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diogenesoftoronto/keating.git"
  },
  "bugs": {
    "url": "https://github.com/Diogenesoftoronto/keating/issues"
  },
  "homepage": "https://keating.help",
  "workspaces": [
    "packages/*",
    "desktop",
    "mobile"
  ],
  "bin": {
    "keating": "bin/keating.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "bin/keating.js",
    "dist/",
    "pi/",
    "scripts/install/",
    "SYSTEM.md",
    "web/.output/"
  ],
  "pi": {
    "extensions": [
      "./dist/src/pi"
    ],
    "skills": [
      "./pi/skills"
    ],
    "prompts": [
      "./pi/prompts"
    ]
  },
  "scripts": {
    "build": "bun x tsc -p tsconfig.json && bun scripts/copy-core-templates.ts && cd web && bun run build",
    "test": "bun test ./test/*.test.ts",
    "mutate": "stryker run",
    "video:intro": "bun scripts/render-keating-intro.mjs",
    "prepack": "bun run build:app",
    "build:app": "bun x tsc -p tsconfig.json && bun scripts/copy-core-templates.ts && KEATING_WEB_BUILD_TARGET=app bun run --cwd web build",
    "textbook": "textbook --web --host 127.0.0.1 --port 6007 --cwd textbook --pattern '**/*.stories.ts'",
    "textbook:tui": "textbook --cwd textbook --pattern '**/*.stories.ts'",
    "textbook:check": "bun x tsc --noEmit -p textbook/tsconfig.json && bun textbook/check.ts"
  },
  "overrides": {
    "@opentui/core": "0.5.14",
    "fast-uri": "3.1.8",
    "hono": "4.13.12",
    "protobufjs": "7.6.6",
    "qs": "6.16.0",
    "ws": "8.22.0"
  },
  "dependencies": {
    "@ax-llm/ax": "^25.0.0",
    "@earendil-works/pi-ai": "0.80.7",
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "@huggingface/tokenizers": "0.2.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentui/core": "0.5.14",
    "@opentui/three": "0.5.14",
    "dotenv": "^18.0.5",
    "h3": "^2.0.1-rc.32",
    "ink": "^7.1.1",
    "jimp": "1.6.1",
    "nitro": "^3.0.260903-beta",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "1.30.0",
    "react": "^19.3.0",
    "three": "0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "textbook-sh": "0.2.0",
    "@remotion/cli": "^4.0.532",
    "@remotion/media-utils": "^4.0.532",
    "@remotion/renderer": "^4.0.532",
    "@stryker-mutator/core": "^10.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.186.0",
    "fast-check": "^4.10.2",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.532"
  }
}
