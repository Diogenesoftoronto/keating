# Build stage
FROM oven/bun:1 AS builder

# The web package consumes the shared learner contracts through a local file
# dependency, so the package must exist before Bun resolves web dependencies.
WORKDIR /app/packages/learner-contracts
COPY packages/learner-contracts/ ./

WORKDIR /app/web
COPY web/package.json web/bun.lock* ./
RUN bun install

# The Nitro course gateway bundles the shared Pear feed directly from the
# monorepo. Keep that source and its native runtime dependencies inside the
# Docker build context so Railway resolves the same graph as local builds.
WORKDIR /app/packages/p2p-core
COPY packages/p2p-core/package.json ./
RUN bun install --production
COPY packages/p2p-core/src ./src

WORKDIR /app
COPY shared/ ./shared/
COPY web/ ./web/
WORKDIR /app/web
# Vite inlines VITE_* env vars at build time. `web/.env.local` is gitignored and
# not present in CI/Railway builds, so these must be supplied as build args
# (Railway forwards matching service variables as --build-arg automatically).
# Without VITE_POSTHOG_PROJECT_TOKEN, initPostHog() compiles down to `return
# null` and analytics never initialize in production.
ARG VITE_POSTHOG_PROJECT_TOKEN
ARG VITE_POSTHOG_HOST="https://us.i.posthog.com"
ARG VITE_POSTHOG_DISABLED="false"
ARG VITE_POSTHOG_SESSION_REPLAY="false"
# Optional build-only credentials for the PostHog source-map upload plugin.
# They are available to the builder RUN step but are never copied into the
# browser environment or the final runtime image.
ARG POSTHOG_API_KEY
ARG POSTHOG_PROJECT_ID
ARG POSTHOG_HOST="https://us.posthog.com"
# This public flag only controls whether the Not Organic model and account
# surfaces are offered. Provider capabilities and signing keys remain server-side.
ARG VITE_NOTORGANIC_ENABLED
ENV VITE_POSTHOG_PROJECT_TOKEN=$VITE_POSTHOG_PROJECT_TOKEN \
    VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST \
    VITE_POSTHOG_DISABLED=$VITE_POSTHOG_DISABLED \
    VITE_POSTHOG_SESSION_REPLAY=$VITE_POSTHOG_SESSION_REPLAY \
    VITE_NOTORGANIC_ENABLED=$VITE_NOTORGANIC_ENABLED \
    NITRO_PRESET=node-server
RUN bun run build

# Serve stage. Nitro's node-server preset wires the Node crossws adapter, which
# intentionally refuses to run under Bun. Keep Bun in the builder, then run the
# generated server on the Node version used by the release workflow.
FROM node:24-bookworm-slim

WORKDIR /app
# Copy the entire Nitro output which includes static assets and the server
COPY --from=builder /app/web/.output ./.output

ENV PORT=3000
ENV HOST=0.0.0.0
EXPOSE 3000

# Run the Nitro server entry point
CMD ["node", ".output/server/index.mjs"]
